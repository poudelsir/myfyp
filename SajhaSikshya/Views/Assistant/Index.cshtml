@using SajhaSikshya.ViewModels.AI
@model AssistantViewModel
@{
    ViewData["Title"] = "AI Assistant";
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold mb-1 d-flex align-items-center gap-2">
            <i data-lucide="sparkles"></i>
            SajhaSikshya Assistant
        </h1>
        <p class="text-secondary mb-0">Ask about buying, selling, donating, verification, orders, reviews, and more.</p>
    </div>
    <button type="button" id="assistantResetBtn" class="btn btn-outline-secondary btn-sm">
        <i data-lucide="rotate-ccw" class="me-1"></i>Reset Conversation
    </button>
</div>

<div class="assistant-shell">
    <div id="assistantMessages" class="assistant-messages" role="log" aria-live="polite" aria-label="Conversation with Sajha AI">
        @if (!Model.History.Any())
        {
            <div class="assistant-empty-state" id="assistantEmptyState">
                <div class="assistant-empty-icon"><i data-lucide="sparkles"></i></div>
                <h2 class="assistant-empty-title">Sajha AI</h2>
                <p class="assistant-empty-subtitle">How can I help you today?</p>
                <div class="assistant-suggestions">
                    @foreach (var question in Model.SuggestedQuestions)
                    {
                        <button type="button" class="assistant-suggestion-chip">@question</button>
                    }
                </div>
            </div>
        }
        @foreach (var message in Model.History)
        {
            <div class="assistant-message assistant-message-@message.Role">
                <div class="assistant-message-bubble" data-raw-text="@message.Text"></div>
            </div>
        }
    </div>

    <form id="assistantForm" class="assistant-composer">
        @Html.AntiForgeryToken()
        <textarea id="assistantQuestionInput" class="assistant-composer-input" placeholder="Ask Sajha AI anything…"
                  rows="1" maxlength="500" aria-label="Message"></textarea>
        <button type="submit" class="assistant-composer-send" id="assistantSendBtn" aria-label="Send message">
            <i data-lucide="send"></i>
        </button>
    </form>
</div>

<template id="assistantEmptyStateTemplate">
    <div class="assistant-empty-state" id="assistantEmptyState">
        <div class="assistant-empty-icon"><i data-lucide="sparkles"></i></div>
        <h2 class="assistant-empty-title">Sajha AI</h2>
        <p class="assistant-empty-subtitle">How can I help you today?</p>
        <div class="assistant-suggestions">
            @foreach (var question in Model.SuggestedQuestions)
            {
                <button type="button" class="assistant-suggestion-chip">@question</button>
            }
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/assistant.js" asp-append-version="true"></script>
}
