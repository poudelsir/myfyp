@using SajhaSikshya.ViewModels.AI
@model AssistantViewModel
@{
    ViewData["Title"] = "AI Assistant";
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold mb-1 d-flex align-items-center gap-2">
            <i data-lucide="sparkles"></i>
            SajhaSikshya Assistant
        </h1>
        <p class="text-secondary mb-0">Ask about buying, selling, donating, verification, orders, reviews, and more.</p>
    </div>
    <button type="button" id="assistantResetBtn" class="btn btn-outline-secondary btn-sm">
        <i data-lucide="rotate-ccw" class="me-1"></i>Reset Conversation
    </button>
</div>

<div class="card assistant-card">
    <div class="card-body d-flex flex-column p-0">
        <div id="assistantMessages" class="assistant-messages">
            @if (!Model.History.Any())
            {
                <div class="assistant-empty-state">
                    <i data-lucide="message-circle-question"></i>
                    <p class="mb-0">Ask me anything about buying, selling, or using SajhaSikshya.</p>
                </div>
            }
            @foreach (var message in Model.History)
            {
                <div class="assistant-message assistant-message-@message.Role">
                    <div class="assistant-message-bubble" data-raw-text="@message.Text"></div>
                </div>
            }
        </div>

        <div id="assistantTyping" class="assistant-typing d-none">
            <span></span><span></span><span></span>
        </div>

        <div id="assistantSuggestions" class="assistant-suggestions @(Model.History.Any() ? "d-none" : "")">
            <p class="text-secondary small mb-2 px-3">Try asking:</p>
            <div class="d-flex flex-wrap gap-2 px-3 pb-2">
                @foreach (var question in Model.SuggestedQuestions)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm assistant-suggestion-chip">@question</button>
                }
            </div>
        </div>

        <form id="assistantForm" class="assistant-input-bar">
            @Html.AntiForgeryToken()
            <input type="text" id="assistantQuestionInput" class="form-control" placeholder="Ask a question…"
                   autocomplete="off" maxlength="500" />
            <button type="submit" class="btn btn-primary" id="assistantSendBtn" aria-label="Send">
                <i data-lucide="send"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/assistant.js" asp-append-version="true"></script>
}
