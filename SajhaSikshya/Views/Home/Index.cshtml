@using SajhaSikshya.Data.Constants
@using SajhaSikshya.Extensions
@using SajhaSikshya.Services.Interfaces.AI
@using SajhaSikshya.Services.Interfaces.Catalog
@using SajhaSikshya.Services.Interfaces.Marketplace
@using SajhaSikshya.Services.Interfaces.Verification
@inject IAdminInsightsService AdminInsightsService
@inject ICategoryService CategoryService
@inject IUniversityService UniversityService
@inject IListingQueryService ListingQueryService
@inject IVerificationQueryService VerificationQueryService
@{
    Layout = "_MarketplaceLayout";
    ViewData["Title"] = "Welcome";
    ViewData["MetaDescription"] = "SajhaSikshya is a premium, AI-powered marketplace where students buy, sell, and donate secondhand books and study materials.";

    var stats = await AdminInsightsService.GetStatsAsync();
    var departments = await CategoryService.GetTopLevelCategoriesWithListingCountsAsync();
    var universities = await UniversityService.GetAllActiveAsync();
    var featured = await ListingQueryService.GetFeaturedListingsAsync(8);
    var recent = await ListingQueryService.GetRecentListingsAsync(8);

    // Hero CTAs adapt to the viewer instead of routing to a different page — a guest and
    // an unverified Student both see "Become a Seller" (the auth redirect chain sends a
    // guest through Login first, landing them right back on the Submit form as a Student),
    // while an already-verified Seller sees their Dashboard instead.
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isStudent = User.IsInRole(Roles.Student);
    var isVerifiedSeller = isAuthenticated && isStudent && await VerificationQueryService.IsUserVerifiedAsync(User.GetUserId()!);

    var recommendedExcludeIds = featured.Select(l => l.Id).Concat(recent.Select(l => l.Id)).ToList();
    var recommended = await ListingQueryService.GetRecommendedListingsAsync(
        isAuthenticated ? User.GetUserId() : null, 8, recommendedExcludeIds);
}

<section class="home-hero">
    <div class="home-hero-grid">
        <div class="home-hero-copy fade-in-up">
            <span class="status-chip status-chip-primary mb-3">
                <i data-lucide="sparkles"></i> AI-Powered Student Marketplace
            </span>
            <h1 class="home-hero-title">
                Buy, sell &amp; donate textbooks —
                <span class="text-gradient">the smart way</span>
            </h1>
            <p class="home-hero-subtitle">
                SajhaSikshya connects verified students to trade secondhand books and study materials,
                with AI-assisted pricing, descriptions, and recommendations along the way.
            </p>

            <form class="home-hero-search" method="get" asp-controller="Marketplace" asp-action="Index">
                <i data-lucide="search"></i>
                <input type="search" name="search" class="form-control form-control-lg" placeholder="Search for textbooks, notes, subjects…" aria-label="Search the marketplace" />
                <button type="submit" class="btn btn-primary btn-lg">Search</button>
            </form>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-controller="Marketplace" asp-action="Index" class="btn btn-primary btn-lg">
                    <i data-lucide="store" class="me-1"></i>Browse Marketplace
                </a>
                @if (isVerifiedSeller)
                {
                    <a asp-area="Student" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i data-lucide="layout-dashboard" class="me-1"></i>Seller Dashboard
                    </a>
                }
                else
                {
                    <a asp-area="Student" asp-controller="Verification" asp-action="Submit" class="btn btn-outline-secondary btn-lg">
                        <i data-lucide="badge-check" class="me-1"></i>Become a Seller
                    </a>
                }
            </div>
        </div>

        <div class="home-hero-visual fade-in-up">
            <div class="home-hero-illustration">
                <div class="home-hero-illustration-card home-hero-illustration-card-1">
                    <span class="home-hero-illustration-icon bg-primary-subtle text-primary"><i data-lucide="book-open"></i></span>
                    <div class="home-hero-illustration-lines">
                        <span></span><span></span>
                    </div>
                </div>
                <div class="home-hero-illustration-card home-hero-illustration-card-2">
                    <span class="home-hero-illustration-icon bg-success-subtle text-success"><i data-lucide="badge-check"></i></span>
                    <div class="home-hero-illustration-lines">
                        <span></span><span></span>
                    </div>
                </div>
                <div class="home-hero-illustration-card home-hero-illustration-card-3">
                    <span class="home-hero-illustration-icon bg-warning-subtle text-warning"><i data-lucide="sparkles"></i></span>
                    <div class="home-hero-illustration-lines">
                        <span></span><span></span>
                    </div>
                </div>
            </div>

            <div class="home-hero-stats">
                <div class="home-hero-stat">
                    <span class="home-hero-stat-icon bg-primary-subtle text-primary"><i data-lucide="book-open"></i></span>
                    <span class="home-hero-stat-body">
                        <span class="home-hero-stat-value">@stats.ActiveListings</span>
                        <span class="home-hero-stat-label">Active Listings</span>
                    </span>
                </div>
                <div class="home-hero-stat">
                    <span class="home-hero-stat-icon bg-success-subtle text-success"><i data-lucide="badge-check"></i></span>
                    <span class="home-hero-stat-body">
                        <span class="home-hero-stat-value">@stats.ApprovedVerifications</span>
                        <span class="home-hero-stat-label">Verified Students</span>
                    </span>
                </div>
                <div class="home-hero-stat">
                    <span class="home-hero-stat-icon bg-warning-subtle text-warning"><i data-lucide="star"></i></span>
                    <span class="home-hero-stat-body">
                        <span class="home-hero-stat-value">@stats.TotalReviews</span>
                        <span class="home-hero-stat-label">Student Reviews</span>
                    </span>
                </div>
                <div class="home-hero-stat">
                    <span class="home-hero-stat-icon bg-info-subtle text-info"><i data-lucide="heart-handshake"></i></span>
                    <span class="home-hero-stat-body">
                        <span class="home-hero-stat-value">@stats.DonationListings</span>
                        <span class="home-hero-stat-label">Books Donated</span>
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="ai-search-banner fade-in-up">
        <div class="ai-search-banner-icon"><i data-lucide="sparkles"></i></div>
        <div class="ai-search-banner-content">
            <h2 class="h5 fw-bold mb-1">Not sure what you're looking for?</h2>
            <p class="text-secondary small mb-0">
                Ask the AI Assistant in plain language — "cheap calculus textbook for first year engineering" —
                and get matched to real listings, pricing guidance, and study advice.
            </p>
        </div>
        <a asp-controller="Assistant" asp-action="Index" class="btn btn-primary flex-shrink-0">
            <i data-lucide="sparkles" class="me-1"></i>Ask the AI Assistant
        </a>
    </div>
</section>

@if (departments.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">Browse by Category</h2>
            <a asp-controller="Marketplace" asp-action="Index" class="small text-decoration-none">View All</a>
        </div>
        <div class="home-category-scroll-wrap">
            <div class="home-category-scroll" id="homeCategoryScroll">
                @{
                    var categoryColorClasses = new[] { "cat-color-1", "cat-color-2", "cat-color-3", "cat-color-4", "cat-color-5", "cat-color-6" };
                    var categoryColorIndex = 0;
                }
                @foreach (var department in departments)
                {
                    var categoryColorClass = categoryColorClasses[categoryColorIndex % categoryColorClasses.Length];
                    categoryColorIndex++;
                    <a asp-controller="Marketplace" asp-action="Index" asp-route-category="@department.Id" class="home-category-card hover-lift">
                        <span class="home-category-icon @categoryColorClass"><i data-lucide="@(department.IconName ?? "shapes")"></i></span>
                        <span class="home-category-name">@department.Name</span>
                        <span class="home-category-count">@department.ListingCount item@(department.ListingCount == 1 ? "" : "s")</span>
                    </a>
                }
            </div>
            <button type="button" class="home-category-scroll-arrow" data-scroll-target="homeCategoryScroll" aria-label="Scroll categories right">
                <i data-lucide="chevron-right"></i>
            </button>
        </div>
    </section>
}

@if (featured.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">Featured Listings</h2>
            <a asp-controller="Marketplace" asp-action="Index" class="small text-decoration-none">Browse Marketplace</a>
        </div>
        <partial name="_ListingCardGrid" model="featured" />
    </section>
}

@if (recommended.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">
                <i data-lucide="sparkles" class="text-primary me-1"></i>Recommended For You
            </h2>
            <a asp-controller="Marketplace" asp-action="Index" class="small text-decoration-none">See All</a>
        </div>
        <partial name="_ListingCardGrid" model="recommended" />
    </section>
}

<section class="mb-5">
    <h2 class="h4 fw-bold text-center mb-4">Why SajhaSikshya</h2>
    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <div class="feature-card h-100">
                <div class="feature-card-icon bg-primary-subtle text-primary"><i data-lucide="badge-check"></i></div>
                <h3 class="h6 fw-semibold mt-3">Verified Students Only</h3>
                <p class="text-secondary small mb-0">Every seller is reviewed and approved before they can list an item.</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="feature-card h-100">
                <div class="feature-card-icon bg-info-subtle text-info"><i data-lucide="sparkles"></i></div>
                <h3 class="h6 fw-semibold mt-3">AI-Powered Pricing</h3>
                <p class="text-secondary small mb-0">Fair price suggestions based on real comparable listings.</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="feature-card h-100">
                <div class="feature-card-icon bg-success-subtle text-success"><i data-lucide="shield-check"></i></div>
                <h3 class="h6 fw-semibold mt-3">Safe Campus Exchange</h3>
                <p class="text-secondary small mb-0">Chat directly with the seller and agree on a safe pickup on campus.</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="feature-card h-100">
                <div class="feature-card-icon bg-warning-subtle text-warning"><i data-lucide="heart-handshake"></i></div>
                <h3 class="h6 fw-semibold mt-3">Community Donations</h3>
                <p class="text-secondary small mb-0">Pass old textbooks forward to students who need them most.</p>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <h2 class="h4 fw-bold text-center mb-4">AI Built Into Every Step</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card h-100">
                <div class="feature-card-icon bg-primary-subtle text-primary"><i data-lucide="file-text"></i></div>
                <h3 class="h6 fw-semibold mt-3">Smart Descriptions</h3>
                <p class="text-secondary small mb-0">Sellers get AI-generated listing descriptions from just a few details.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card h-100">
                <div class="feature-card-icon bg-success-subtle text-success"><i data-lucide="tag"></i></div>
                <h3 class="h6 fw-semibold mt-3">Price Recommendations</h3>
                <p class="text-secondary small mb-0">AI suggests a fair price based on similar recent sales.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card h-100">
                <div class="feature-card-icon bg-info-subtle text-info"><i data-lucide="message-circle"></i></div>
                <h3 class="h6 fw-semibold mt-3">Marketplace Assistant</h3>
                <p class="text-secondary small mb-0">Ask the AI Assistant to help you find exactly what you need.</p>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="donation-banner fade-in-up">
        <div class="donation-banner-content">
            <span class="status-chip status-chip-warning mb-2"><i data-lucide="heart-handshake"></i> Community Giving</span>
            <h2 class="h4 fw-bold mb-2">Pass your books forward</h2>
            <p class="mb-3">
                @(stats.DonationListings) book@(stats.DonationListings == 1 ? "" : "s") have been donated by generous students so far.
                Give your old textbooks a second life instead of letting them collect dust.
            </p>
            <a asp-controller="Marketplace" asp-action="Index" asp-route-donation="true" class="btn btn-primary">
                <i data-lucide="heart" class="me-1"></i>Browse Donations
            </a>
        </div>
    </div>
</section>

@if (recent.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">Recently Listed</h2>
            <a asp-controller="Marketplace" asp-action="Index" asp-route-recent="true" class="small text-decoration-none">View All</a>
        </div>
        <partial name="_ListingCardGrid" model="recent" />
    </section>
}

@if (universities.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">Popular Universities</h2>
        </div>
        <div class="home-university-grid">
            @foreach (var university in universities.Take(8))
            {
                <a asp-controller="Marketplace" asp-action="Index" asp-route-university="@university.Id" class="home-university-card hover-lift">
                    <span class="home-university-icon"><i data-lucide="landmark"></i></span>
                    <span class="home-university-name">@university.Name</span>
                    @if (!string.IsNullOrEmpty(university.City))
                    {
                        <span class="home-university-city text-secondary small">@university.City</span>
                    }
                </a>
            }
        </div>
    </section>
}

<section class="mb-4">
    <h2 class="h4 fw-bold text-center mb-4">How It Works</h2>
    <div class="row g-4">
        <div class="col-md-3">
            <div class="how-it-works-step">
                <span class="how-it-works-number">1</span>
                <h3 class="h6 fw-semibold">Create an Account</h3>
                <p class="text-secondary small mb-0">Sign up with your student email and get verified for full marketplace access.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="how-it-works-step">
                <span class="how-it-works-number">2</span>
                <h3 class="h6 fw-semibold">List or Browse</h3>
                <p class="text-secondary small mb-0">Sell your used books with AI-generated descriptions and pricing, or browse what others are offering.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="how-it-works-step">
                <span class="how-it-works-number">3</span>
                <h3 class="h6 fw-semibold">Chat &amp; Agree</h3>
                <p class="text-secondary small mb-0">Message the seller directly, ask questions, and agree on a pickup time.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="how-it-works-step">
                <span class="how-it-works-number">4</span>
                <h3 class="h6 fw-semibold">Meet &amp; Exchange</h3>
                <p class="text-secondary small mb-0">Complete the exchange, then leave a review to build trust in the community.</p>
            </div>
        </div>
    </div>
</section>
