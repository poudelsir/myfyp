@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-4">
    <span class="brand-mark brand-mark-lg mx-auto mb-3 bg-danger-subtle text-danger">!</span>
    <h1 class="h4 fw-bold mb-2">Something went wrong</h1>
    <p class="text-secondary mb-3">@(Model.Message ?? "An unexpected error occurred while processing your request.")</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small mb-4">Reference ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
</div>
