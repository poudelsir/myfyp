@using SajhaSikshya.DTOs.Notifications
@model NotificationPreferenceDto
@{
    ViewData["Title"] = "Notification Preferences";
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold mb-1">Notification Preferences</h1>
        <p class="text-secondary mb-0">Choose which categories of notifications you want to receive.</p>
    </div>
    <a asp-controller="Notifications" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i data-lucide="arrow-left" class="me-1"></i>Back to Notifications
    </a>
</div>

<div class="card" style="max-width: 560px;">
    <div class="card-body">
        <form asp-controller="Notifications" asp-action="Preferences" method="post">
            <div class="form-check form-switch mb-3">
                <input asp-for="ChatEnabled" class="form-check-input" role="switch" />
                <label asp-for="ChatEnabled" class="form-check-label">Chat — new messages</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="OrdersEnabled" class="form-check-input" role="switch" />
                <label asp-for="OrdersEnabled" class="form-check-label">Orders — created, confirmed, ready, completed, cancelled</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="VerificationEnabled" class="form-check-input" role="switch" />
                <label asp-for="VerificationEnabled" class="form-check-label">Verification — submission and review updates</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="MarketplaceEnabled" class="form-check-input" role="switch" />
                <label asp-for="MarketplaceEnabled" class="form-check-label">Marketplace — listing approval, rejection, archive, restore</label>
            </div>
            <div class="form-check form-switch mb-4">
                <input asp-for="AnnouncementsEnabled" class="form-check-input" role="switch" />
                <label asp-for="AnnouncementsEnabled" class="form-check-label">Announcements — system notices from administrators</label>
            </div>

            <hr />

            <p class="text-secondary small mb-2">Future delivery channels — no email or push is actually sent yet, but your preference is saved for when they are.</p>
            <div class="form-check form-switch mb-3">
                <input asp-for="EmailEnabled" class="form-check-input" role="switch" />
                <label asp-for="EmailEnabled" class="form-check-label">Email notifications <span class="badge text-bg-secondary">Coming soon</span></label>
            </div>
            <div class="form-check form-switch mb-4">
                <input asp-for="PushEnabled" class="form-check-input" role="switch" />
                <label asp-for="PushEnabled" class="form-check-label">Push notifications <span class="badge text-bg-secondary">Coming soon</span></label>
            </div>

            <button type="submit" class="btn btn-primary">
                <i data-lucide="save" class="me-1"></i>Save Preferences
            </button>
        </form>
    </div>
</div>
