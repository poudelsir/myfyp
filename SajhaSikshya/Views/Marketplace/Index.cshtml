@using Microsoft.AspNetCore.Mvc.Rendering
@using SajhaSikshya.Data.Enums
@using SajhaSikshya.Extensions
@using SajhaSikshya.ViewModels.Marketplace
@model MarketplaceHomeViewModel
@{
    var hasSearchTerm = !string.IsNullOrWhiteSpace(Model.Criteria.SearchTerm);

    ViewData["Title"] = hasSearchTerm ? $"Search: {Model.Criteria.SearchTerm}" : "Marketplace";
    ViewData["MetaDescription"] = "Browse secondhand books, notes, and study materials shared by students.";

    var topCategories = Model.BrowseCategories.Take(8).ToList();
    // Featured/Recent/Browse are already correctly bounded upstream (FeaturedCount/RecentCount/PageSize
    // in MarketplaceController) — re-truncating here silently dropped real, matching listings below what
    // the page's own "N results" heading and pagination control promised.
    var featuredCards = Model.Featured;
    var recommendationCards = Model.Recent;
    var browseItems = Model.Browse.Items;
    var heading = hasSearchTerm
        ? $"Search results for “{Model.Criteria.SearchTerm}”"
        : Model.IsFiltered
            ? $"Browsing: {Model.CategoryName ?? Model.SubjectName ?? Model.UniversityName ?? Model.AcademicLevelName ?? "Filtered Listings"}"
            : "All Listings";
}

<section class="marketplace-landing">
    <div class="marketplace-hero">
        <div class="marketplace-hero-copy">
            <span class="marketplace-pill">
                <i data-lucide="sparkles"></i>
                Verified Student Marketplace
            </span>

            <h1>Student Marketplace</h1>
            <p>
                Buy, sell, or donate books, notes, and campus essentials with trusted students from your university.
            </p>

            <form method="get" asp-action="Index" class="marketplace-hero-search">
                <i data-lucide="search"></i>
                <input type="search" name="search" value="@Model.Criteria.SearchTerm" class="form-control"
                       placeholder="Search for books, notes, and subjects..." aria-label="Search the marketplace" />
                <button type="submit" class="btn btn-primary">Search</button>
            </form>

            <div class="marketplace-hero-actions">
                <a asp-controller="Marketplace" asp-action="Index" class="btn btn-primary">Browse Books</a>
                <a asp-area="Student" asp-controller="Listings" asp-action="Create" class="btn btn-outline-secondary">Sell Your Book</a>
            </div>

            <div class="marketplace-hero-tags">
                <span>Textbooks</span>
                <span>Notes &amp; Papers</span>
                <span>Lab Equipment</span>
                <span>Stationery</span>
            </div>
        </div>

        <div class="marketplace-hero-aside">
            <div class="marketplace-stack-card">
                <div class="stack-book stack-book-large"></div>
                <div class="stack-book stack-book-medium"></div>
                <div class="stack-book stack-book-small"></div>
                <div class="stack-plant"></div>
            </div>

            <div class="marketplace-mini-stats">
                <div class="mini-stat">
                    <strong>5,200+</strong>
                    <span>Verified Students</span>
                </div>
                <div class="mini-stat">
                    <strong>12,400+</strong>
                    <span>Books Listed</span>
                </div>
                <div class="mini-stat">
                    <strong>98%</strong>
                    <span>Happy Students</span>
                </div>
            </div>
        </div>
    </div>

    <div class="marketplace-strip">
        <div class="strip-item">
            <i data-lucide="badge-check"></i>
            <span>Verified Students</span>
        </div>
        <div class="strip-item">
            <i data-lucide="shield-check"></i>
            <span>Safe campus trading</span>
        </div>
        <div class="strip-item">
            <i data-lucide="sparkles"></i>
            <span>AI price guidance</span>
        </div>
        <div class="strip-item">
            <i data-lucide="heart-handshake"></i>
            <span>Book donations</span>
        </div>
    </div>

    <section class="marketplace-section">
        <div class="section-header">
            <h2>Browse by Category</h2>
            <a asp-controller="Marketplace" asp-action="Index">View All Categories</a>
        </div>

        <div class="marketplace-category-grid">
            @if (topCategories.Any())
            {
                @foreach (var category in topCategories)
                {
                    <a asp-controller="Marketplace" asp-action="Index" asp-route-category="@category.Id" class="marketplace-category-card">
                        <span class="marketplace-category-icon">
                            <i data-lucide="@(string.IsNullOrWhiteSpace(category.IconName) ? "book-open" : category.IconName)"></i>
                        </span>
                        <span class="marketplace-category-name">@category.Name</span>
                    </a>
                }
            }
            else
            {
                <div class="marketplace-empty-state compact">
                    <i data-lucide="package-search"></i>
                    <p class="mb-0">Categories will appear here soon.</p>
                </div>
            }
        </div>
    </section>

    @if (featuredCards.Any())
    {
        <section class="marketplace-section">
            <div class="section-header">
                <h2>Featured Listings</h2>
                <a asp-controller="Marketplace" asp-action="Index">View All</a>
            </div>
            <partial name="_ListingCardGrid" model="featuredCards" />
        </section>
    }

    <section class="marketplace-section">
        <div class="marketplace-ai-banner">
            <div class="marketplace-ai-icon">
                <i data-lucide="sparkles"></i>
            </div>
            <div class="marketplace-ai-copy">
                <h3>Need help finding the right book?</h3>
                <p>Ask the AI assistant for recommendations based on your course, university, and budget.</p>
            </div>
            <a asp-controller="Assistant" asp-action="Index" class="btn btn-primary">Ask the AI Assistant</a>
        </div>
    </section>

    @if (recommendationCards.Any())
    {
        <section class="marketplace-section">
            <div class="section-header">
                <h2>AI Recommendations</h2>
                <a asp-controller="Marketplace" asp-action="Index">See More</a>
            </div>
            <partial name="_ListingCardGrid" model="recommendationCards" />
        </section>
    }

    <section class="marketplace-section">
        <div class="marketplace-donation-banner">
            <div class="marketplace-donation-copy">
                <h3>Have books to spare?</h3>
                <p>Donate gently used textbooks and study materials to students who need them most.</p>
                <a asp-controller="Marketplace" asp-action="Index" asp-route-donation="true" class="btn btn-primary">Donate Now</a>
            </div>
            <div class="marketplace-donation-illustration" aria-hidden="true">
                <div class="donation-box"></div>
                <div class="donation-book"></div>
                <div class="donation-hand"></div>
            </div>
        </div>
    </section>

    <section class="marketplace-section">
        <div class="section-header">
            <h2>@heading</h2>
            <div class="listing-meta">
                <span>@Model.Browse.TotalCount result@(Model.Browse.TotalCount == 1 ? "" : "s")</span>
                @if (Model.IsFiltered)
                {
                    <a asp-action="Index" class="small text-decoration-none">Clear Filters</a>
                }
            </div>
        </div>

        @if (Model.UsedRelaxedSearch)
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-3" role="status">
                <i data-lucide="info" class="flex-shrink-0"></i>
                <span>No exact match for “@Model.Criteria.SearchTerm” — showing the closest related listings instead.</span>
            </div>
        }

        <div class="marketplace-results-toolbar">
            <form method="get" asp-action="Index" class="marketplace-inline-filters">
                <input type="text" name="search" value="@Model.Criteria.SearchTerm" placeholder="Search listings" class="form-control form-control-sm" />
                @if (Model.Criteria.CategoryId.HasValue)
                {
                    <input type="hidden" name="category" value="@Model.Criteria.CategoryId" />
                }
                @if (Model.Criteria.UniversityId.HasValue)
                {
                    <input type="hidden" name="university" value="@Model.Criteria.UniversityId" />
                }
                @if (Model.Criteria.SubjectId.HasValue)
                {
                    <input type="hidden" name="subject" value="@Model.Criteria.SubjectId" />
                }
                @if (Model.Criteria.AcademicLevelId.HasValue)
                {
                    <input type="hidden" name="academicLevel" value="@Model.Criteria.AcademicLevelId" />
                }
                @if (Model.Criteria.Condition.HasValue)
                {
                    <input type="hidden" name="condition" value="@Model.Criteria.Condition" />
                }
                @if (Model.Criteria.MinPrice.HasValue)
                {
                    <input type="hidden" name="minPrice" value="@Model.Criteria.MinPrice" />
                }
                @if (Model.Criteria.MaxPrice.HasValue)
                {
                    <input type="hidden" name="maxPrice" value="@Model.Criteria.MaxPrice" />
                }
                @if (Model.Criteria.DonationOnly)
                {
                    <input type="hidden" name="donation" value="true" />
                }
                @if (Model.Criteria.RecentlyAddedOnly)
                {
                    <input type="hidden" name="recent" value="true" />
                }
                @if (Model.Criteria.OnlyWithImages)
                {
                    <input type="hidden" name="hasImages" value="true" />
                }
                @if (Model.Criteria.VerifiedSellerOnly)
                {
                    <input type="hidden" name="verifiedSeller" value="true" />
                }
                <select name="sort" class="form-select form-select-sm" asp-items="EnumExtensions.GetSelectList<ListingSortOption>(Model.Criteria.Sort)">
                    <option value="">Sort by</option>
                </select>
                <button type="submit" class="btn btn-primary btn-sm">Apply</button>
            </form>
        </div>

        <partial name="_ListingCardGrid" model="browseItems"
                 view-data='new ViewDataDictionary(ViewData) { ["EmptyMessage"] = Model.IsFiltered ? "No listings match your search or filters. Try broadening them." : "No listings yet." }' />
        <partial name="_QueryPreservingPagination" model="Model.Browse" />
    </section>
</section>
