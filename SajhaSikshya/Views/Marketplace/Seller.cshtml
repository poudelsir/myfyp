@using SajhaSikshya.ViewModels.Marketplace
@model SellerProfileViewModel
@{
    ViewData["Title"] = $"{Model.Seller.SellerName}'s Listings";
    ViewData["MetaDescription"] = $"Browse listings from {Model.Seller.SellerName} on SajhaSikshya.";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Marketplace" asp-action="Index">Marketplace</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Seller.SellerName</li>
    </ol>
</nav>

<div class="marketplace-seller-card mb-4" style="max-width: 480px;">
    <partial name="_Avatar" model="(Model.Seller.ProfilePicturePath, Model.Seller.SellerName)" />
    <div>
        <p class="mb-0 fw-semibold d-flex align-items-center gap-1">
            @Model.Seller.SellerName
            <partial name="_VerifiedStudentBadge" model="Model.Seller.IsVerified" />
        </p>
        <p class="mb-0 text-secondary small">
            Member since @Model.Seller.MemberSinceUtc.ToLocalTime().ToString("MMMM yyyy")
            &middot; @Model.Seller.ActiveListingCount active listing@(Model.Seller.ActiveListingCount == 1 ? "" : "s")
        </p>
        <p class="mb-0 d-flex align-items-center gap-1">
            @if (Model.Seller.ReviewCount > 0)
            {
                <partial name="_StarRatingDisplay" model="Model.Seller.AverageRating" />
                <a asp-controller="Reviews" asp-action="ForUser" asp-area="" asp-route-userId="@Model.Seller.SellerId" class="small text-decoration-none">
                    @Model.Seller.AverageRating.ToString("0.0") (@Model.Seller.ReviewCount review@(Model.Seller.ReviewCount == 1 ? "" : "s"))
                </a>
            }
            else
            {
                <span class="text-secondary small">No reviews yet</span>
            }
        </p>

        @if (Model.Seller.IsVerified && !string.IsNullOrEmpty(Model.Seller.SellerTypeDisplay))
        {
            <p class="mb-0 text-secondary small">
                @Model.Seller.SellerTypeDisplay
                @if (!string.IsNullOrEmpty(Model.Seller.InstitutionName))
                {
                    <text> &middot; @Model.Seller.InstitutionName</text>
                }
            </p>
        }
    </div>
</div>

<div class="row g-3 mb-4" style="max-width: 480px;">
    <div class="col-4">
        <p class="mb-0 h5 fw-bold">@Model.Seller.TotalListingCount</p>
        <p class="mb-0 text-secondary small">Total Listings</p>
    </div>
    <div class="col-4">
        <p class="mb-0 h5 fw-bold">@Model.Seller.CompletedOrderCount</p>
        <p class="mb-0 text-secondary small">Completed Orders</p>
    </div>
    <div class="col-4">
        <p class="mb-0 h5 fw-bold">@Model.Seller.ReviewCount</p>
        <p class="mb-0 text-secondary small">Reviews</p>
    </div>
</div>

@if (Model.Seller.IsVerified && Model.Seller.SellingCategoryDisplays.Any())
{
    <div class="mb-4">
        <p class="text-secondary small mb-2">Sells</p>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var category in Model.Seller.SellingCategoryDisplays)
            {
                <span class="badge text-bg-secondary fw-normal">@category</span>
            }
        </div>
    </div>
}

<h2 class="h5 fw-bold mb-3">Listings from @Model.Seller.SellerName</h2>
<partial name="_ListingCardGrid" model="Model.Listings.Items" view-data='new ViewDataDictionary(ViewData) { ["EmptyMessage"] = "This seller has no active listings right now." }' />
<partial name="_MarketplacePagination" model="Model.Listings"
         view-data='new ViewDataDictionary(ViewData) { ["PaginationAction"] = "Seller", ["SellerId"] = Model.Seller.SellerId }' />
