@using SajhaSikshya.Data.Constants
@{
    // Backs the handful of root-level (area-less) authenticated views that are reachable
    // by either role — Notifications and the public Reviews/ForUser page — so they still
    // render inside a management shell with the role-appropriate sidebar, same as before
    // the Student/Admin layouts were split apart.
    Layout = "_ManagementLayout";
    ViewData["SidebarPartial"] = User.IsInRole(Roles.Admin) ? "_AdminSidebar" : "_StudentSidebar";
}
