@using SajhaSikshya.Constants
@using SajhaSikshya.Data.Constants
@using SajhaSikshya.Data.Enums
@using SajhaSikshya.DTOs.Notifications
@using SajhaSikshya.Extensions
@using SajhaSikshya.Services.Interfaces.Catalog
@using SajhaSikshya.Services.Interfaces.Chat
@using SajhaSikshya.Services.Interfaces.Marketplace
@using SajhaSikshya.Services.Interfaces.Notifications
@using SajhaSikshya.Services.Interfaces.Verification
@inject ICompareService CompareService
@inject IVerificationQueryService VerificationQueryService
@inject IUniversityService UniversityService
@inject IChatQueryService ChatQueryService
@inject INotificationQueryService NotificationQueryService
@{
    var appName = "SajhaSikshya";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var compareCount = isAuthenticated
        ? (await CompareService.GetCompareListingIdsAsync(User.GetUserId()!)).Count
        : Context.Session.GetCompareListingIds().Count;
    var metaDescription = ViewData["MetaDescription"] as string
        ?? "Buy, sell, and donate secondhand books and study materials with fellow students.";
    var ogTitle = ViewData["OgTitle"] as string ?? $"{ViewData["Title"]} - {appName}";
    var ogImage = ViewData["OgImage"] as string;
    var ogType = ViewData["OgType"] as string ?? "website";
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";

    var initials = "?";
    var fullName = "Guest";
    var isCurrentUserVerified = false;
    var isStudent = User.IsInRole(Roles.Student);
    var isAdmin = User.IsInRole(Roles.Admin);
    var unreadChatCount = 0;
    var unreadNotificationCount = 0;
    var recentNotifications = new List<NotificationDto>();

    if (isAuthenticated)
    {
        fullName = User.GetFullName() ?? User.Identity!.Name ?? "User";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : fullName.Length > 0 ? fullName[0].ToString().ToUpperInvariant() : "?";

        var userId = User.GetUserId()!;
        if (isStudent)
        {
            isCurrentUserVerified = await VerificationQueryService.IsUserVerifiedAsync(userId);
            unreadChatCount = await ChatQueryService.GetUnreadCountAsync(userId);
        }

        unreadNotificationCount = await NotificationQueryService.GetUnreadCountAsync(userId);
        var recentPage = await NotificationQueryService.GetHistoryAsync(userId, 1, NotificationConstants.RecentNotificationsCount);
        recentNotifications = recentPage.Items.ToList();
    }

    var universities = await UniversityService.GetAllActiveAsync();

    string IconFor(NotificationType type) => type switch
    {
        NotificationType.Message => "message-circle",
        NotificationType.Order => "package",
        NotificationType.Review => "star",
        NotificationType.Verification => "shield-check",
        NotificationType.AIRecommendation => "sparkles",
        NotificationType.Announcement => "megaphone",
        _ => "bell",
    };
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @appName</title>

    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:site_name" content="@appName" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonicalUrl" />
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{ogImage}")" />
    }

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/marketplace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/verification.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="@(isAuthenticated ? "true" : "false")">
    <div class="announcement-bar" id="announcementBar">
        <div class="container-fluid d-flex align-items-center justify-content-center gap-2 flex-wrap">
            <i data-lucide="sparkles"></i>
            <span>Nepal's AI-powered academic marketplace — buy, sell, and donate books with fellow students.</span>
            <a asp-controller="Marketplace" asp-action="Index" class="announcement-bar-link">Explore the marketplace</a>
        </div>
        <button type="button" class="announcement-bar-close" id="announcementBarClose" aria-label="Dismiss announcement">
            <i data-lucide="x"></i>
        </button>
    </div>
    @if (isAuthenticated)
    {
        <form id="notificationTokenForm" class="d-none">@Html.AntiForgeryToken()</form>
    }
    <header class="marketplace-navbar">
        <div class="container-fluid d-flex align-items-center gap-2 gap-lg-3">
            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none flex-shrink-0">
                <span class="brand-mark">S</span>
                <span class="brand-text d-none d-sm-inline">SajhaSikshya</span>
            </a>

            <button type="button" class="btn-icon d-lg-none flex-shrink-0" data-bs-toggle="collapse" data-bs-target="#marketplaceNavLinks" aria-controls="marketplaceNavLinks" aria-expanded="false" aria-label="Toggle navigation">
                <i data-lucide="menu"></i>
            </button>

            <nav class="marketplace-nav-links d-none d-lg-flex align-items-center gap-1">
                <a asp-controller="Home" asp-action="Index" class="marketplace-nav-link">Home</a>
                <a asp-controller="Marketplace" asp-action="Index" class="marketplace-nav-link">Marketplace</a>
                <div class="dropdown">
                    <button type="button" class="marketplace-nav-link marketplace-nav-link-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        Universities <i data-lucide="chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu">
                        @foreach (var university in universities)
                        {
                            <li><a class="dropdown-item" asp-controller="Marketplace" asp-action="Index" asp-route-university="@university.Id">@university.Name</a></li>
                        }
                        @if (!universities.Any())
                        {
                            <li><span class="dropdown-item-text text-secondary small">No universities yet</span></li>
                        }
                    </ul>
                </div>
                <a asp-controller="Assistant" asp-action="Index" class="marketplace-nav-link d-flex align-items-center gap-1">
                    <i data-lucide="sparkles"></i> AI Assistant
                </a>
                <a asp-controller="Marketplace" asp-action="Index" asp-route-donation="true" class="marketplace-nav-link d-flex align-items-center gap-1">
                    <i data-lucide="heart-handshake"></i> Donate
                </a>
                <a asp-controller="Home" asp-action="About" class="marketplace-nav-link">About</a>
            </nav>

            <form class="navbar-search d-none d-md-flex ms-lg-2" role="search" aria-label="Site search" method="get" asp-controller="Marketplace" asp-action="Index">
                <i data-lucide="search" class="navbar-search-icon"></i>
                <input type="search" name="search" class="form-control" placeholder="Search the marketplace…" aria-label="Search"
                       value="@Context.Request.Query["search"]" />
            </form>

            <a asp-controller="Assistant" asp-action="Index" class="btn btn-sm gradient-primary-soft text-primary d-none d-md-inline-flex align-items-center gap-1 flex-shrink-0" title="Ask the AI Assistant">
                <i data-lucide="sparkles"></i> AI Search
            </a>

            <div class="navbar-spacer"></div>

            <button type="button" class="btn-icon" id="darkModeToggleBtn" aria-label="Toggle dark mode" title="Toggle dark mode">
                <i data-lucide="moon" id="darkModeIcon"></i>
            </button>

            @if (isStudent)
            {
                <a asp-area="Student" asp-controller="SavedListings" asp-action="Index" class="btn-icon" title="Wishlist" aria-label="Wishlist">
                    <i data-lucide="heart"></i>
                </a>
                <a asp-area="Student" asp-controller="Chat" asp-action="Index" class="btn-icon position-relative" title="Messages" aria-label="Messages">
                    <i data-lucide="message-circle"></i>
                    <span id="marketplaceChatDot" class="notification-dot @(unreadChatCount > 0 ? "" : "d-none")"></span>
                </a>
            }

            @if (isAuthenticated)
            {
                <div class="dropdown">
                    <button type="button" class="btn-icon position-relative" id="marketplaceNotificationsDropdown"
                            data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications" title="Notifications">
                        <i data-lucide="bell"></i>
                        <span class="notification-dot @(unreadNotificationCount > 0 ? "" : "d-none")"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notification-panel" aria-labelledby="marketplaceNotificationsDropdown">
                        <div class="notification-panel-header d-flex justify-content-between align-items-center">
                            <span>Notifications <span class="badge text-bg-primary rounded-pill @(unreadNotificationCount > 0 ? "" : "d-none")">@unreadNotificationCount</span></span>
                        </div>
                        <div class="notification-panel-list @(recentNotifications.Any() ? "" : "d-none")">
                            @foreach (var notification in recentNotifications)
                            {
                                <a class="notification-panel-item @(notification.IsRead ? "" : "is-unread")"
                                   href="@(string.IsNullOrEmpty(notification.Link) ? "/notifications" : notification.Link)">
                                    <i data-lucide="@IconFor(notification.NotificationType)" class="flex-shrink-0"></i>
                                    <span class="notification-panel-item-body">
                                        <span class="notification-panel-item-title">@notification.Title</span>
                                        <span class="notification-panel-item-message">@notification.Message</span>
                                    </span>
                                </a>
                            }
                        </div>
                        <div class="notification-panel-empty @(recentNotifications.Any() ? "d-none" : "")">
                            <i data-lucide="bell-off"></i>
                            <p class="mb-0">You're all caught up.</p>
                        </div>
                        <a href="/notifications" class="notification-panel-footer">View All Notifications</a>
                    </div>
                </div>
            }

            @if (isStudent && isCurrentUserVerified)
            {
                <a asp-area="Student" asp-controller="Listings" asp-action="Create" class="btn btn-primary btn-sm d-none d-sm-inline-flex">
                    <i data-lucide="plus" class="me-1"></i>Create Listing
                </a>
            }
            else if (isStudent)
            {
                <a asp-area="Student" asp-controller="Verification" asp-action="Submit" class="btn btn-primary btn-sm d-none d-sm-inline-flex">
                    <i data-lucide="badge-check" class="me-1"></i>Become a Seller
                </a>
            }

            @if (isAuthenticated)
            {
                <div class="dropdown">
                    <button type="button" class="btn-profile" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar-initials">@initials</span>
                        <span class="d-none d-xl-inline">@fullName</span>
                        <i data-lucide="chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                        <li>
                            <h6 class="dropdown-header d-flex align-items-center gap-1">
                                @fullName
                                <partial name="_VerifiedStudentBadge" model="isCurrentUserVerified" />
                            </h6>
                        </li>
                        @if (isAdmin)
                        {
                            <li><a class="dropdown-item disabled" href="#" aria-disabled="true"><i data-lucide="user" class="me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i data-lucide="layout-dashboard" class="me-2"></i>Admin Dashboard</a></li>
                        }
                        else
                        {
                            <li><a class="dropdown-item" asp-area="Student" asp-controller="Profile" asp-action="Index"><i data-lucide="user" class="me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" asp-area="Student" asp-controller="Orders" asp-action="Index"><i data-lucide="package" class="me-2"></i>My Orders</a></li>
                            @if (isCurrentUserVerified)
                            {
                                <li><a class="dropdown-item" asp-area="Student" asp-controller="Dashboard" asp-action="Index"><i data-lucide="store" class="me-2"></i>Seller Dashboard</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-area="Student" asp-controller="SavedListings" asp-action="Index"><i data-lucide="heart" class="me-2"></i>Wishlist</a></li>
                                <li><a class="dropdown-item" asp-area="Student" asp-controller="Verification" asp-action="Submit"><i data-lucide="badge-check" class="me-2"></i>Become a Verified Seller</a></li>
                            }
                        }
                        <li><a class="dropdown-item" href="/notifications/preferences"><i data-lucide="settings" class="me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-0">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i data-lucide="log-out" class="me-2"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm">Sign In</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm d-none d-sm-inline-flex">Sign Up</a>
            }
        </div>

        <div class="collapse d-lg-none marketplace-nav-links-mobile" id="marketplaceNavLinks">
            <div class="container-fluid d-flex flex-column gap-1 py-2">
                <a asp-controller="Home" asp-action="Index" class="marketplace-nav-link">Home</a>
                <a asp-controller="Marketplace" asp-action="Index" class="marketplace-nav-link">Marketplace</a>
                <a asp-controller="Assistant" asp-action="Index" class="marketplace-nav-link">AI Assistant</a>
                <a asp-controller="Marketplace" asp-action="Index" asp-route-donation="true" class="marketplace-nav-link">Donate</a>
                <a asp-controller="Home" asp-action="About" class="marketplace-nav-link">About</a>
                @if (isStudent)
                {
                    <a asp-area="Student" asp-controller="SavedListings" asp-action="Index" class="marketplace-nav-link">Wishlist</a>
                }
            </div>
        </div>
    </header>

    <main class="marketplace-main">
        <div class="container-fluid py-4">
            @if (TempData[SajhaSikshya.Helpers.AlertHelper.SuccessKey] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData[SajhaSikshya.Helpers.AlertHelper.ErrorKey] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <partial name="_MarketplaceFooter" />

    @if (compareCount > 0)
    {
        <a asp-controller="Compare" asp-action="Index" class="marketplace-compare-fab">
            <i data-lucide="git-compare"></i>
            Compare
            <span class="marketplace-compare-fab-count">@compareCount</span>
        </a>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dark-mode.js" asp-append-version="true"></script>
    <script src="~/js/announcement-bar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
