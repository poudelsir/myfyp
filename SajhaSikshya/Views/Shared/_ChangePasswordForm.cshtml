@using SajhaSikshya.ViewModels.Account
@model ChangePasswordViewModel
@{
    // Same <partial ... for="ChangePassword"> field-prefix trick as _PersonalInfoForm — see
    // that file's comment. Reused by Student/Admin Profile AND Student/Admin Settings.
    var postUrl = ViewData["ChangePasswordPostUrl"] as string ?? Url.Action("ChangePassword", "Profile")!;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<h3 class="h6 fw-semibold small mb-2">Change Password</h3>
<form method="post" action="@postUrl" class="mb-4" style="max-width: 480px;">
    @Html.AntiForgeryToken()
    @if (!string.IsNullOrEmpty(returnUrl))
    {
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    }
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("ChangePassword")))
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
    }
    <div class="mb-2">
        <label asp-for="CurrentPassword" class="form-label small"></label>
        <input asp-for="CurrentPassword" class="form-control form-control-sm" />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    </div>
    <div class="mb-2">
        <label asp-for="NewPassword" class="form-label small"></label>
        <input asp-for="NewPassword" class="form-control form-control-sm" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label small"></label>
        <input asp-for="ConfirmPassword" class="form-control form-control-sm" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Change Password</button>
</form>
<p class="text-secondary small mb-0">
    Forgot your password instead? <a asp-area="" asp-controller="Account" asp-action="ForgotPassword">Reset it by email</a> — that flow stays separate from this one.
</p>
