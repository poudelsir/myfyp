@using SajhaSikshya.Extensions
@using SajhaSikshya.Services.Interfaces.Chat
@inject IChatQueryService ChatQueryService
@{
    var isAdmin = User.IsInRole(SajhaSikshya.Data.Constants.Roles.Admin);
    var dashboardArea = isAdmin ? "Admin" : "Student";

    // Initial value only — chat.js overwrites this live via the "UnreadCountUpdated"
    // SignalR event once connected, the same "server-rendered first paint, then
    // real-time takes over" pattern the rest of Phase 7.2 uses.
    var unreadChatCount = !isAdmin && User.Identity?.IsAuthenticated == true
        ? await ChatQueryService.GetUnreadCountAsync(User.GetUserId()!)
        : 0;
}
<aside class="app-sidebar" id="appSidebar">
    <div class="sidebar-brand">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
            <span class="brand-mark">S</span>
            <span class="brand-text">SajhaSikshya</span>
        </a>
        <button type="button" class="btn-icon d-lg-none" id="sidebarCloseBtn" aria-label="Close sidebar">
            <i data-lucide="x"></i>
        </button>
    </div>

    <nav class="sidebar-nav">
        <p class="sidebar-section-title">Main</p>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="@dashboardArea" asp-controller="Dashboard" asp-action="Index">
                    <i data-lucide="layout-dashboard"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="Assistant" asp-action="Index">
                    <i data-lucide="sparkles"></i>
                    <span>AI Assistant</span>
                </a>
            </li>
            @if (isAdmin)
            {
                <li class="nav-item">
                    <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                        <i data-lucide="users"></i>
                        <span>Manage Users</span>
                        <span class="badge text-bg-secondary ms-auto">Soon</span>
                    </a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="Listings" asp-action="Index">
                        <i data-lucide="tag"></i>
                        <span>My Listings</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="Orders" asp-action="Index">
                        <i data-lucide="package"></i>
                        <span>My Orders</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="Chat" asp-action="Index">
                        <i data-lucide="message-circle"></i>
                        <span>Messages</span>
                        <span id="chatUnreadBadge" class="badge text-bg-primary rounded-pill ms-auto @(unreadChatCount > 0 ? "" : "d-none")">@unreadChatCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="SavedListings" asp-action="Index">
                        <i data-lucide="heart"></i>
                        <span>Saved Listings</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="Verification" asp-action="Index">
                        <i data-lucide="shield-check"></i>
                        <span>My Verification</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Student" asp-controller="Reviews" asp-action="Index">
                        <i data-lucide="star"></i>
                        <span>My Reviews</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                        <i data-lucide="book-open"></i>
                        <span>My Courses</span>
                        <span class="badge text-bg-secondary ms-auto">Soon</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                        <i data-lucide="graduation-cap"></i>
                        <span>My Progress</span>
                        <span class="badge text-bg-secondary ms-auto">Soon</span>
                    </a>
                </li>
            }
        </ul>

        @if (isAdmin)
        {
            <p class="sidebar-section-title">Marketplace</p>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Listings" asp-action="Index">
                        <i data-lucide="shield-check"></i>
                        <span>Listing Moderation</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Verifications" asp-action="Index">
                        <i data-lucide="badge-check"></i>
                        <span>Student Verification</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                        <i data-lucide="package"></i>
                        <span>Orders</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                        <i data-lucide="star"></i>
                        <span>Review Moderation</span>
                    </a>
                </li>
            </ul>

            <p class="sidebar-section-title">Notifications</p>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="BroadcastNotifications" asp-action="Index">
                        <i data-lucide="megaphone"></i>
                        <span>Broadcast Notification</span>
                    </a>
                </li>
            </ul>

            <p class="sidebar-section-title">Catalog</p>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Universities" asp-action="Index">
                        <i data-lucide="landmark"></i>
                        <span>Universities</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="AcademicLevels" asp-action="Index">
                        <i data-lucide="layers"></i>
                        <span>Academic Levels</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Subjects" asp-action="Index">
                        <i data-lucide="book-open"></i>
                        <span>Subjects</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                        <i data-lucide="folder-tree"></i>
                        <span>Categories</span>
                    </a>
                </li>
            </ul>
        }

        <p class="sidebar-section-title">Account</p>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                    <i data-lucide="user"></i>
                    <span>Profile</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/notifications/preferences">
                    <i data-lucide="bell-ring"></i>
                    <span>Notification Preferences</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
