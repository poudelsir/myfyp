@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="text-center mb-4">
    <span class="status-chip status-chip-primary mb-2"><i data-lucide="sparkles"></i> Join SajhaSikshya</span>
    <h1 class="h4 fw-bold mb-1">Create your student account</h1>
    <p class="text-secondary mb-0">It only takes a minute to get started.</p>
</div>

<form asp-controller="Account" asp-action="Register" method="post" novalidate>
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="FirstName" class="form-label"></label>
            <div class="input-icon-group">
                <i data-lucide="user"></i>
                <input asp-for="FirstName" class="form-control" autofocus />
            </div>
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="LastName" class="form-label"></label>
            <div class="input-icon-group">
                <i data-lucide="user"></i>
                <input asp-for="LastName" class="form-control" />
            </div>
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-icon-group">
            <i data-lucide="mail"></i>
            <input asp-for="Email" class="form-control" autocomplete="username" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-icon-group">
            <i data-lucide="lock"></i>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <div class="input-icon-group">
            <i data-lucide="lock"></i>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Create Account</button>

    <p class="text-center text-secondary mt-4 mb-0">
        Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
