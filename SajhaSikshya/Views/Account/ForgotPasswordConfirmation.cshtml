@{
    ViewData["Title"] = "Check Your Email";
}

<div class="text-center py-3">
    <span class="brand-mark brand-mark-lg mx-auto mb-3 bg-success-subtle text-success"><i data-lucide="mail-check"></i></span>
    <h1 class="h4 fw-bold mb-2">Check your email</h1>
    <p class="text-secondary mb-4">
        If an account exists for that email address, we've sent a link to reset your password.
        The link expires in a couple of hours and can only be used once.
    </p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Back to Sign In</a>
</div>
