@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="text-center mb-4">
    <span class="status-chip status-chip-primary mb-2"><i data-lucide="key-round"></i> Choose a New Password</span>
    <h1 class="h4 fw-bold mb-1">Reset your password</h1>
    <p class="text-secondary mb-0">Enter a new password for your account.</p>
</div>

<form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <div class="input-icon-group">
            <i data-lucide="lock"></i>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <div class="input-icon-group">
            <i data-lucide="lock"></i>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Reset Password</button>

    <p class="text-center text-secondary mt-4 mb-0">
        Remembered your password? <a asp-controller="Account" asp-action="Login">Sign in</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
