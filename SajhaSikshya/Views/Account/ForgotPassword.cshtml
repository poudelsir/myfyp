@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="text-center mb-4">
    <span class="status-chip status-chip-primary mb-2"><i data-lucide="key-round"></i> Reset Access</span>
    <h1 class="h4 fw-bold mb-1">Forgot your password?</h1>
    <p class="text-secondary mb-0">Enter your email and we'll send you a link to reset it.</p>
</div>

<form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    }

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-icon-group">
            <i data-lucide="mail"></i>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>

    <p class="text-center text-secondary mt-4 mb-0">
        Remembered your password? <a asp-controller="Account" asp-action="Login">Sign in</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
