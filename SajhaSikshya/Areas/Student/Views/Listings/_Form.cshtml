@using SajhaSikshya.Data.Enums
@using SajhaSikshya.Extensions
@using SajhaSikshya.ViewModels.Marketplace
@model ListingFormViewModel

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" autofocus />
    <span asp-validation-for="Title" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions" class="form-select" id="departmentSelect">
            <option value="">— Select a department —</option>
        </select>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select" id="subcategorySelect">
            <option value="">— Select a department first —</option>
            @foreach (var subcategory in Model.SubcategoryOptions)
            {
                <option value="@subcategory.Id" data-parent-id="@subcategory.ParentCategoryId" selected="@(subcategory.Id == Model.CategoryId)">@subcategory.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="SubjectId" class="form-label"></label>
        <input type="text" id="subjectSearchInput" class="form-control" list="subjectsDatalist"
               placeholder="Type to search subjects…" autocomplete="off"
               value="@(Model.SubjectOptions.FirstOrDefault(o => o.Selected)?.Text)" />
        <datalist id="subjectsDatalist">
            @foreach (var subject in Model.SubjectOptions)
            {
                <option value="@subject.Text"></option>
            }
        </datalist>
        <input type="hidden" asp-for="SubjectId" id="subjectIdInput" />
        <span asp-validation-for="SubjectId" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="UniversityName" class="form-label"></label>
        <input asp-for="UniversityName" class="form-control" list="universitiesDatalist"
               placeholder="Type your university (optional)…" autocomplete="off" />
        <datalist id="universitiesDatalist">
            @foreach (var universityName in Model.UniversityNameOptions)
            {
                <option value="@universityName"></option>
            }
        </datalist>
        <span asp-validation-for="UniversityName" class="text-danger small"></span>
        <div class="form-text">Not listed? Just type it — we'll add it for you.</div>
    </div>
</div>

@* Consumed by listing-form.js's subject-typeahead script — plain inline data, not a
   @section (see this file's closing comment for why @section can't be used here). *@
<script type="application/json" id="subjectNameToIdMap">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubjectOptions.GroupBy(o => o.Text).ToDictionary(g => g.Key, g => g.First().Value)))</script>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" asp-items="EnumExtensions.GetSelectList<BookCondition>(Model.Condition)" class="form-select">
        </select>
        <span asp-validation-for="Condition" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="PriceAmount" class="form-label"></label>
        <input asp-for="PriceAmount" class="form-control" id="priceInput" />
        <span asp-validation-for="PriceAmount" class="text-danger small"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="StockQuantity" class="form-label"></label>
        <input asp-for="StockQuantity" class="form-control" />
        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
    </div>
</div>

<div class="mb-4 form-check form-switch">
    <input asp-for="IsDonation" class="form-check-input" role="switch" id="isDonationInput" />
    <label asp-for="IsDonation" class="form-check-label"></label>
</div>

<div class="mb-4">
    <button type="button" id="aiGenerateBtn" class="btn btn-outline-primary btn-sm" data-generate-url="@Url.Action("GenerateDescription")">
        <i data-lucide="sparkles" class="me-1"></i>Generate with AI
    </button>
    <div id="aiGenerateStatus" class="form-text mt-1"></div>
    <div id="aiKeywordsHint" class="form-text mt-1 d-none"></div>
</div>

<div class="mb-4">
    <button type="button" id="aiPriceBtn" class="btn btn-outline-primary btn-sm" data-price-url="@Url.Action("RecommendPrice")" data-listing-id="@Model.Id">
        <i data-lucide="sparkles" class="me-1"></i>AI Price Recommendation
    </button>
    <div id="aiPriceStatus" class="form-text mt-1"></div>
    <div id="aiPriceResult" class="card mt-2 d-none" style="max-width: 480px;">
        <div class="card-body py-2 px-3">
            <p class="mb-1"><strong>Suggested Price:</strong> NPR <span id="aiPriceSuggested"></span></p>
            <p class="mb-1 text-secondary small">
                <strong>Range:</strong> NPR <span id="aiPriceRange"></span>
                &middot; <strong>Confidence:</strong> <span id="aiPriceConfidence"></span>
            </p>
            <p class="mb-2 text-secondary small" id="aiPriceExplanation"></p>
            <button type="button" id="aiApplyPriceBtn" class="btn btn-sm btn-primary">Apply Suggested Price</button>
        </div>
    </div>
</div>

@* Save/Cancel buttons are NOT here — each of Create.cshtml/Edit.cshtml renders its own,
   positioned after the Product Images section rather than before it. Scripts for this
   form live in wwwroot/js/listing-form.js, referenced from the two views that actually
   render @section Scripts for this request (Create.cshtml / Edit.cshtml) — a @section
   defined inside a <partial>-rendered view like this one is never picked up by the
   outer Layout, so it can't be declared here. *@
