@using SajhaSikshya.Data.Enums
@using SajhaSikshya.ViewModels.Chat
@model ConversationAttachmentsViewModel
@{
    var c = Model.Conversation;
    ViewData["Title"] = $"Attachments with {c.OtherPartyName}";

    string FormatFileSize(long? bytes)
    {
        if (!bytes.HasValue)
        {
            return string.Empty;
        }

        double kb = bytes.Value / 1024.0;
        return kb < 1024 ? $"{kb:0.#} KB" : $"{kb / 1024.0:0.#} MB";
    }
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h5 fw-bold mb-0">Attachments with @c.OtherPartyName</h1>
        <p class="text-secondary small mb-0">
            From <a asp-controller="Marketplace" asp-action="Details" asp-area="" asp-route-slug="@c.ListingSlug">@c.ListingTitle</a>
        </p>
    </div>
    <a asp-action="Conversation" asp-route-id="@c.Id" class="btn btn-outline-secondary btn-sm">
        <i data-lucide="arrow-left" class="me-1"></i>Back to Conversation
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (!Model.Attachments.Items.Any())
        {
            <p class="text-secondary text-center py-4 mb-0">No images or files have been shared in this conversation yet.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var attachment in Model.Attachments.Items)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        @if (attachment.MessageType == MessageType.Image)
                        {
                            <a href="@Url.Action("Attachment", new { messageId = attachment.Id })" target="_blank" rel="noopener" class="d-block text-decoration-none">
                                <img src="@Url.Action("Attachment", new { messageId = attachment.Id })" alt="@attachment.OriginalFileName"
                                     class="img-fluid rounded border" style="width:100%;height:140px;object-fit:cover;" />
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Attachment", new { messageId = attachment.Id, download = true })" class="d-flex flex-column align-items-center justify-content-center text-decoration-none text-body border rounded p-3" style="height:140px;">
                                <i data-lucide="file-text" style="width:32px;height:32px;"></i>
                                <span class="small text-truncate mt-2" style="max-width:100%;">@attachment.OriginalFileName</span>
                                <span class="text-secondary small">@FormatFileSize(attachment.FileSizeBytes)</span>
                            </a>
                        }
                        <p class="text-secondary small mb-0 mt-1 text-truncate">@attachment.SenderName &middot; @attachment.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</p>
                    </div>
                }
            </div>

            <partial name="_QueryPreservingPagination" model="Model.Attachments" />
        }
    </div>
</div>
