@using SajhaSikshya.ViewModels.Chat
@model ConversationListViewModel
@{
    ViewData["Title"] = "Messages";
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold mb-1">Messages</h1>
        <p class="text-secondary mb-0">Conversations with buyers and sellers about marketplace listings.</p>
    </div>
    <a asp-action="Search" class="btn btn-outline-secondary btn-sm">
        <i data-lucide="search" class="me-1"></i>Search Messages
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <input type="search" name="searchTerm" value="@Model.SearchTerm" class="form-control" style="max-width: 280px;"
                   placeholder="Search by name, listing, or message…" aria-label="Search" />
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="includeArchived" name="includeArchived" value="true" @(Model.IncludeArchived ? "checked" : "") />
                <label class="form-check-label" for="includeArchived">Show archived</label>
            </div>
            <button type="submit" class="btn btn-outline-secondary">
                <i data-lucide="search" class="me-1"></i>Filter
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.IncludeArchived)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </form>

        @if (!Model.Page.Items.Any())
        {
            <p class="text-secondary text-center py-4 mb-0">No conversations yet. Message a seller from a listing page to get started.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var conversation in Model.Page.Items)
                {
                    <a asp-action="Conversation" asp-route-id="@conversation.Id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 @(conversation.IsArchived ? "opacity-75" : "")">
                        @if (!string.IsNullOrEmpty(conversation.OtherPartyProfilePicturePath))
                        {
                            <img src="@conversation.OtherPartyProfilePicturePath" alt="@conversation.OtherPartyName" style="width:40px;height:40px;object-fit:cover;border-radius:50%;flex-shrink:0;" />
                        }
                        else
                        {
                            <span class="avatar-initials flex-shrink-0">@(conversation.OtherPartyName.Length > 0 ? conversation.OtherPartyName[0].ToString().ToUpperInvariant() : "?")</span>
                        }
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <p class="mb-0 fw-semibold text-truncate">@conversation.OtherPartyName</p>
                                @if (conversation.LastMessageAtUtc.HasValue)
                                {
                                    <span class="text-secondary small flex-shrink-0">@conversation.LastMessageAtUtc.Value.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                }
                            </div>
                            <p class="mb-0 text-secondary small text-truncate">@conversation.ListingTitle</p>
                            @if (!string.IsNullOrEmpty(conversation.LastMessagePreview))
                            {
                                <p class="mb-0 text-secondary small text-truncate">@conversation.LastMessagePreview</p>
                            }
                        </div>
                        @if (conversation.UnreadCount > 0)
                        {
                            <span class="badge text-bg-primary rounded-pill flex-shrink-0">@conversation.UnreadCount</span>
                        }
                        @if (conversation.IsArchived)
                        {
                            <span class="badge text-bg-secondary flex-shrink-0">Archived</span>
                        }
                    </a>
                }
            </div>

            <partial name="_QueryPreservingPagination" model="Model.Page" />
        }
    </div>
</div>
