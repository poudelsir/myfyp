@using SajhaSikshya.Data.Enums
@using SajhaSikshya.Extensions
@using SajhaSikshya.ViewModels.Student.Profile
@model ProfileIndexViewModel
@{
    ViewData["Title"] = "My Profile";
    var verification = Model.Verification;
    var isVerified = verification?.Status == VerificationStatus.Verified;
    var isPending = verification?.Status == VerificationStatus.Pending;
}

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">My Profile</h1>
    <p class="text-secondary mb-0">Your account and seller information.</p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Personal Information</h2>
        <form asp-controller="Profile" asp-action="UpdatePersonalInfo" method="post" enctype="multipart/form-data">
            <div class="d-flex align-items-center gap-3 mb-4">
                <partial name="_Avatar" model="(Model.PersonalInfo.ProfilePicturePath, Model.PersonalInfo.FirstName)" />
                <div class="flex-grow-1">
                    <label asp-for="PersonalInfo.ProfilePhoto" class="form-label small mb-1">Profile Photo</label>
                    <input asp-for="PersonalInfo.ProfilePhoto" type="file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp" />
                    <span asp-validation-for="PersonalInfo.ProfilePhoto" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="PersonalInfo.FirstName" class="form-label small">First Name</label>
                    <input asp-for="PersonalInfo.FirstName" class="form-control" />
                    <span asp-validation-for="PersonalInfo.FirstName" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PersonalInfo.LastName" class="form-label small">Last Name</label>
                    <input asp-for="PersonalInfo.LastName" class="form-control" />
                    <span asp-validation-for="PersonalInfo.LastName" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label class="form-label small">Email</label>
                    <input value="@Model.PersonalInfo.Email" class="form-control" disabled readonly />
                    <div class="form-text">Contact support to change your email address.</div>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PersonalInfo.PhoneNumber" class="form-label small">Phone Number</label>
                    <input asp-for="PersonalInfo.PhoneNumber" class="form-control" autocomplete="off" />
                    <span asp-validation-for="PersonalInfo.PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PersonalInfo.Address" class="form-label small">Address <span class="text-secondary fw-normal">(Optional)</span></label>
                    <input asp-for="PersonalInfo.Address" class="form-control" autocomplete="off" />
                    <span asp-validation-for="PersonalInfo.Address" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PersonalInfo.Institution" class="form-label small">Institution <span class="text-secondary fw-normal">(Optional)</span></label>
                    <input asp-for="PersonalInfo.Institution" class="form-control" autocomplete="off" placeholder="e.g. Tribhuvan University" />
                    <span asp-validation-for="PersonalInfo.Institution" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="PersonalInfo.Bio" class="form-label small">Bio <span class="text-secondary fw-normal">(Optional)</span></label>
                    <textarea asp-for="PersonalInfo.Bio" class="form-control" rows="3" maxlength="500"></textarea>
                    <span asp-validation-for="PersonalInfo.Bio" class="text-danger small"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Account Information</h2>
        <dl class="row small mb-0">
            <dt class="col-4 col-sm-3 text-secondary">Account Type</dt>
            <dd class="col-8 col-sm-9">@(isVerified ? "Verified Seller" : "User")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Member Since</dt>
            <dd class="col-8 col-sm-9">@Model.MemberSinceUtc.ToLocalTime().ToString("MMMM d, yyyy")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Verification Status</dt>
            <dd class="col-8 col-sm-9">@(verification?.StatusDisplay ?? "Not Started")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Email Verified</dt>
            <dd class="col-8 col-sm-9">@(Model.EmailConfirmed ? "Yes" : "No")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Phone Verified</dt>
            <dd class="col-8 col-sm-9">@(Model.PhoneNumberConfirmed ? "Yes" : "No")</dd>
        </dl>
    </div>
</div>

@if (isVerified)
{
    <div class="verification-status-card mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <h2 class="h6 fw-bold mb-0 d-flex align-items-center gap-2">
                Seller Information
                <partial name="_VerificationStatusBadge" model="verification!.Status" />
            </h2>
            <div class="d-flex gap-2">
                <a asp-area="Student" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm">
                    <i data-lucide="store" class="me-1"></i>Seller Dashboard
                </a>
                <a asp-controller="Verification" asp-action="Resubmit" class="btn btn-outline-secondary btn-sm">
                    <i data-lucide="pencil" class="me-1"></i>Update Application
                </a>
            </div>
        </div>

        <dl class="row small mb-0">
            <dt class="col-4 col-sm-3 text-secondary">Seller Type</dt>
            <dd class="col-8 col-sm-9">@(verification!.SellerTypeDisplay ?? "—")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Institution</dt>
            <dd class="col-8 col-sm-9">@(string.IsNullOrWhiteSpace(verification.InstitutionName) ? "—" : verification.InstitutionName)</dd>

            <dt class="col-4 col-sm-3 text-secondary">Academic Identity</dt>
            <dd class="col-8 col-sm-9">@(verification.HasAcademicId ? (verification.AcademicIdDocumentTypeDisplay ?? "Provided") : "Not provided")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Verification Date</dt>
            <dd class="col-8 col-sm-9">@(verification.ReviewedAtUtc.HasValue ? verification.ReviewedAtUtc.Value.ToLocalTime().ToString("MMMM d, yyyy") : "—")</dd>
        </dl>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 fw-semibold mb-1">Intended Selling Categories</h2>
            <p class="text-secondary small mb-3">Used for moderation and marketplace insights — safe to update any time without affecting your seller status.</p>

            <form asp-controller="Profile" asp-action="UpdateSellingCategories" method="post">
                <div class="row row-cols-1 row-cols-sm-2 g-2 mb-3">
                    @foreach (var category in Enum.GetValues<SellingCategory>())
                    {
                        var inputId = $"profileSellingCategory_{category}";
                        var isChecked = verification!.SellingCategories.Contains(category);
                        <div class="col">
                            <div class="form-check">
                                <input type="checkbox" name="categories" value="@category" class="form-check-input" id="@inputId" checked="@isChecked" />
                                <label class="form-check-label small" for="@inputId">@category.GetDisplayName()</label>
                            </div>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Save Categories</button>
            </form>
        </div>
    </div>
}
else if (isPending)
{
    <div class="verification-status-card mb-4 d-flex align-items-center gap-3 flex-wrap">
        <div class="verification-status-icon is-pending">
            <i data-lucide="clock"></i>
        </div>
        <div class="flex-grow-1">
            <h2 class="h6 fw-bold mb-1">Pending Verification</h2>
            <p class="text-secondary mb-0">Your seller application is under review. This usually takes 24–48 hours.</p>
        </div>
        <a asp-controller="Verification" asp-action="Index" class="btn btn-outline-secondary btn-sm flex-shrink-0">View Status</a>
    </div>
}
else
{
    <div class="donation-banner mb-4">
        <div class="donation-banner-content">
            <span class="status-chip status-chip-primary mb-2"><i data-lucide="badge-check"></i> Unlock Selling</span>
            <h2 class="h5 fw-bold mb-2">Become a Verified Seller</h2>
            <p class="mb-3">
                Get verified by our admin team to start listing your own books, track sales, and access seller
                analytics. Verification is quick — just complete a one-time application.
            </p>
            <a asp-controller="Verification" asp-action="Submit" class="btn btn-primary">
                <i data-lucide="badge-check" class="me-1"></i>Become a Verified Seller
            </a>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Security</h2>

        <h3 class="h6 fw-semibold small mb-2">Change Password</h3>
        <form asp-controller="Profile" asp-action="ChangePassword" method="post" class="mb-4" style="max-width: 480px;">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("ChangePassword")))
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
            }
            <div class="mb-2">
                <label asp-for="ChangePassword.CurrentPassword" class="form-label small"></label>
                <input asp-for="ChangePassword.CurrentPassword" class="form-control form-control-sm" />
                <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="mb-2">
                <label asp-for="ChangePassword.NewPassword" class="form-label small"></label>
                <input asp-for="ChangePassword.NewPassword" class="form-control form-control-sm" />
                <span asp-validation-for="ChangePassword.NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ChangePassword.ConfirmPassword" class="form-label small"></label>
                <input asp-for="ChangePassword.ConfirmPassword" class="form-control form-control-sm" />
                <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Change Password</button>
        </form>

        <hr />

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 py-2">
            <div>
                <h3 class="h6 fw-semibold small mb-1">Manage Sessions</h3>
                <p class="text-secondary small mb-0">View and sign out of your active sessions on other devices.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Not available yet</button>
        </div>

        <hr />

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 py-2">
            <div>
                <h3 class="h6 fw-semibold small mb-1 text-danger">Delete Account</h3>
                <p class="text-secondary small mb-0">Permanently delete your account and all associated data.</p>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm" disabled>Not available yet</button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
