@using SajhaSikshya.ViewModels.Verification
@model VerificationSubmissionViewModel
@{
    ViewData["Title"] = "Submit Verification";
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Become a Verified Seller</h1>
    <p class="text-secondary mb-0">
        To maintain a trusted academic marketplace, every seller must complete a one-time verification. This helps
        protect buyers, reduce fraudulent activities, and improve marketplace safety.
    </p>
</div>

<div class="alert alert-info d-flex align-items-center gap-2" style="max-width: 720px;">
    <i data-lucide="clock" style="width:18px;height:18px;flex-shrink:0;"></i>
    <div>
        <strong>Estimated review time: 24–48 hours.</strong>
        You can keep browsing and purchasing on SajhaSikshya while your application is reviewed.
    </div>
</div>

<div class="card" style="max-width: 720px;">
    <div class="card-body">
        <form asp-action="Submit" method="post" enctype="multipart/form-data" novalidate>
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            }
            <partial name="_SubmissionForm" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
