@using SajhaSikshya.Data.Enums
@using SajhaSikshya.Extensions
@using SajhaSikshya.ViewModels.Verification
@model VerificationSubmissionViewModel

<div class="mb-4">
    <h2 class="h6 fw-semibold mb-2">Your Account</h2>
    <dl class="row small text-secondary mb-0">
        <dt class="col-4">Name</dt>
        <dd class="col-8">@Model.AccountFullName</dd>
        <dt class="col-4">Email</dt>
        <dd class="col-8">@Model.AccountEmail</dd>
        <dt class="col-4">Phone</dt>
        <dd class="col-8">@(string.IsNullOrWhiteSpace(Model.AccountPhoneNumber) ? "—" : Model.AccountPhoneNumber)</dd>
    </dl>
</div>

<hr class="mb-4" />

<h2 class="h6 fw-semibold mb-3">Government Identity Document</h2>
<div class="mb-3">
    <label asp-for="GovernmentIdDocumentType" class="form-label">Document Type</label>
    <select asp-for="GovernmentIdDocumentType" asp-items="EnumExtensions.GetSelectList<GovernmentIdDocumentType>()" class="form-select">
        <option value="">— Select document type —</option>
    </select>
    <span asp-validation-for="GovernmentIdDocumentType" class="text-danger small"></span>
</div>
<div class="mb-4">
    <label asp-for="GovernmentIdImage" class="form-label">Upload Document</label>
    <input asp-for="GovernmentIdImage" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,application/pdf" id="governmentIdImageInput" />
    <div class="form-text">Citizenship Certificate, National ID Card, Passport, or Driving License (JPG, PNG, WEBP, or PDF, up to 5 MB).</div>
    <span asp-validation-for="GovernmentIdImage" class="text-danger small"></span>
    <img id="governmentIdImagePreview" class="verification-upload-preview" alt="Government ID preview" />
</div>

<h2 class="h6 fw-semibold mb-1">Academic Identity <span class="text-secondary fw-normal">(Optional)</span></h2>
<p class="text-secondary small mb-3">Providing an academic ID is optional but helps increase buyer confidence.</p>
<div class="mb-3">
    <label asp-for="AcademicIdDocumentType" class="form-label">Document Type</label>
    <select asp-for="AcademicIdDocumentType" asp-items="EnumExtensions.GetSelectList<AcademicIdDocumentType>()" class="form-select">
        <option value="">— None / not applicable —</option>
    </select>
    <span asp-validation-for="AcademicIdDocumentType" class="text-danger small"></span>
</div>
<div class="mb-4">
    <label asp-for="AcademicIdImage" class="form-label">Upload Document</label>
    <input asp-for="AcademicIdImage" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,application/pdf" id="academicIdImageInput" />
    <div class="form-text">Student ID, College ID, University ID, Teacher ID, or Institution ID (JPG, PNG, WEBP, or PDF, up to 5 MB).</div>
    <span asp-validation-for="AcademicIdImage" class="text-danger small"></span>
    <img id="academicIdImagePreview" class="verification-upload-preview" alt="Academic ID preview" />
</div>

<h2 class="h6 fw-semibold mb-3">Profile Photo</h2>
<div class="mb-4">
    <label asp-for="ProfilePhoto" class="form-label">Upload a recent, clear photo of yourself</label>
    <input asp-for="ProfilePhoto" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" id="profilePhotoInput" />
    <div class="form-text">Used to verify your identity against your government ID and increase buyer trust (JPG, PNG, or WEBP, up to 5 MB).</div>
    <span asp-validation-for="ProfilePhoto" class="text-danger small"></span>
    <img id="profilePhotoPreview" class="verification-upload-preview" alt="Profile photo preview" />
</div>

<h2 class="h6 fw-semibold mb-3">Seller Type</h2>
<div class="mb-3">
    <label asp-for="SellerType" class="form-label">Which best describes you?</label>
    <select asp-for="SellerType" asp-items="EnumExtensions.GetSelectList<SellerType>()" class="form-select">
        <option value="">— Select an option —</option>
    </select>
    <span asp-validation-for="SellerType" class="text-danger small"></span>
</div>
<div class="mb-4">
    <label asp-for="InstitutionName" class="form-label">Institution / Organization <span class="text-secondary fw-normal">(Optional)</span></label>
    <input asp-for="InstitutionName" class="form-control" autocomplete="off" placeholder="e.g. Tribhuvan University, XYZ College" />
    <span asp-validation-for="InstitutionName" class="text-danger small"></span>
</div>

<h2 class="h6 fw-semibold mb-3">Intended Selling Categories</h2>
<div class="mb-4">
    <div class="row row-cols-1 row-cols-sm-2 g-2">
        @foreach (var category in Enum.GetValues<SellingCategory>())
        {
            var inputId = $"sellingCategory_{category}";
            var isChecked = Model.SellingCategories.Contains(category);
            <div class="col">
                <div class="form-check">
                    <input type="checkbox" name="SellingCategories" value="@category" class="form-check-input" id="@inputId" checked="@isChecked" />
                    <label class="form-check-label small" for="@inputId">@category.GetDisplayName()</label>
                </div>
            </div>
        }
    </div>
    <span asp-validation-for="SellingCategories" class="text-danger small"></span>
</div>

<h2 class="h6 fw-semibold mb-3">Seller Declaration</h2>
<div class="mb-4">
    @* Plain (non-asp-for) checkbox — the Input Tag Helper's generated jQuery-unobtrusive
       "range" validator compares a bool's data-val-range-min/max (rendered as
       PascalCase "True" from bool.ToString()) against the checkbox's lowercase
       value="true" as a case-sensitive string range, which incorrectly fails even when
       checked. Server-side [Range(typeof(bool), "true", "true")] validates correctly
       (real bool comparison, not string), so this only opts the field out of the
       broken client-side adapter — same unbound-checkbox pattern already used above
       for SellingCategories, with asp-validation-for still showing any server-side
       round-trip error message. *@
    <div class="form-check">
        <input type="checkbox" name="DeclarationAccepted" value="true" class="form-check-input" id="DeclarationAccepted" checked="@Model.DeclarationAccepted" />
        <label class="form-check-label small" for="DeclarationAccepted">
            I certify that all information and documents submitted are genuine. I agree to comply with SajhaSikshya Marketplace
            policies and understand that submitting false information or engaging in fraudulent activities may result in
            rejection, suspension, or permanent removal of my seller account.
        </label>
        <div><span asp-validation-for="DeclarationAccepted" class="text-danger small"></span></div>
    </div>
</div>

<div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Submit for Review</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</div>

@* Plain inline <script>, not @section Scripts — sections aren't supported inside
   partial views (they only work in the top-level view rendered for the request), and
   this element-lookup script only needs to run after the elements above it exist,
   which is already true by the time the parser reaches this tag. *@
<script>
    (function () {
        "use strict";

        var previewPairs = [
            ["governmentIdImageInput", "governmentIdImagePreview"],
            ["academicIdImageInput", "academicIdImagePreview"],
            ["profilePhotoInput", "profilePhotoPreview"],
        ];

        previewPairs.forEach(function (pair) {
            var input = document.getElementById(pair[0]);
            var preview = document.getElementById(pair[1]);

            input?.addEventListener("change", function () {
                var file = input.files && input.files[0];
                if (!file || file.type === "application/pdf") {
                    preview.classList.remove("is-visible");
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.add("is-visible");
                };
                reader.readAsDataURL(file);
            });
        });
    })();
</script>
