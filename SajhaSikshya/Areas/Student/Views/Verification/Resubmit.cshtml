@using SajhaSikshya.ViewModels.Verification
@model VerificationSubmissionViewModel
@{
    ViewData["Title"] = "Resubmit Verification";
    var previousReason = ViewData["PreviousRejectionReason"] as string;
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Resubmit Your Seller Application</h1>
    <p class="text-secondary mb-0">Your previous submission wasn't approved. Review the reason below, then submit updated documents.</p>
</div>

@if (!string.IsNullOrWhiteSpace(previousReason))
{
    <div class="alert alert-warning" style="max-width: 720px;">
        <strong>Why it wasn't approved:</strong> @previousReason
    </div>
}

<div class="alert alert-info d-flex align-items-center gap-2" style="max-width: 720px;">
    <i data-lucide="clock" style="width:18px;height:18px;flex-shrink:0;"></i>
    <div>
        <strong>Estimated review time: 24–48 hours.</strong>
        You can keep browsing and purchasing on SajhaSikshya while your application is reviewed.
    </div>
</div>

<div class="card" style="max-width: 720px;">
    <div class="card-body">
        <form asp-action="Resubmit" method="post" enctype="multipart/form-data" novalidate>
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            }
            <partial name="_SubmissionForm" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
