@using SajhaSikshya.DTOs.Catalog
@using SajhaSikshya.ViewModels.Admin.Shared
@model AdminListViewModel<SubjectDto>
@{
    ViewData["Title"] = "Subjects";
    ViewData["SearchTerm"] = Model.SearchTerm;
    ViewData["SearchPlaceholder"] = "Search by name or code…";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 fw-bold mb-1">Subjects</h1>
        <p class="text-secondary mb-0">Academic subjects, each tied to a level and optionally a university.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i data-lucide="plus" class="me-1"></i>Add Subject
    </a>
</div>

<div class="card">
    <div class="card-body">
        <partial name="_AdminSearchBox" />

        @if (!Model.Page.Items.Any())
        {
            <p class="text-secondary text-center py-4 mb-0">No subjects found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Code</th>
                            <th>Academic Level</th>
                            <th>University</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in Model.Page.Items)
                        {
                            <tr>
                                <td>@subject.Name</td>
                                <td>@(subject.Code ?? "—")</td>
                                <td>@subject.AcademicLevelName</td>
                                <td>@(subject.UniversityName ?? "Any university")</td>
                                <td>
                                    @if (subject.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@subject.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@subject.Id" method="post" class="d-inline js-delete-form"
                                          data-confirm="Delete '@subject.Name'? This cannot be undone.">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model.Page" />
        }
    </div>
</div>
