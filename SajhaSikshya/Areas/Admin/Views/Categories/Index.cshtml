@using SajhaSikshya.DTOs.Catalog
@using SajhaSikshya.ViewModels.Admin.Shared
@model AdminListViewModel<CategoryDto>
@{
    ViewData["Title"] = "Categories";
    ViewData["SearchTerm"] = Model.SearchTerm;
    ViewData["SearchPlaceholder"] = "Search by name or slug…";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 fw-bold mb-1">Categories</h1>
        <p class="text-secondary mb-0">Content categories, optionally nested under a parent.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i data-lucide="plus" class="me-1"></i>Add Category
    </a>
</div>

<div class="card">
    <div class="card-body">
        <partial name="_AdminSearchBox" />

        @if (!Model.Page.Items.Any())
        {
            <p class="text-secondary text-center py-4 mb-0">No categories found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Parent</th>
                            <th>Subcategories</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Page.Items)
                        {
                            <tr>
                                <td>@category.DisplayOrder</td>
                                <td>@category.Name</td>
                                <td><code>@category.Slug</code></td>
                                <td>@(category.ParentCategoryName ?? "—")</td>
                                <td>@category.SubcategoryCount</td>
                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline js-delete-form"
                                          data-confirm="Delete '@category.Name'? This cannot be undone.">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="Model.Page" />
        }
    </div>
</div>
