@using SajhaSikshya.ViewModels.Admin.Profile
@model AdminProfileIndexViewModel
@{
    ViewData["Title"] = "My Profile";
    ViewData["PersonalInfoPostUrl"] = Url.Action("UpdatePersonalInfo", "Profile");
    ViewData["ChangePasswordPostUrl"] = Url.Action("ChangePassword", "Profile");
    ViewData["RoleLabel"] = "System Administrator";
}

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">My Profile</h1>
    <p class="text-secondary mb-0">Your administrator account information.</p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Personal Information</h2>
        <partial name="_PersonalInfoForm" for="PersonalInfo" />
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Account Information</h2>
        <dl class="row small mb-0">
            <dt class="col-4 col-sm-3 text-secondary">Account Role</dt>
            <dd class="col-8 col-sm-9"><span class="badge text-bg-primary">System Administrator</span></dd>

            <dt class="col-4 col-sm-3 text-secondary">Account Status</dt>
            <dd class="col-8 col-sm-9">
                <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.IsActive ? "Active" : "Disabled")</span>
            </dd>

            <dt class="col-4 col-sm-3 text-secondary">Member Since</dt>
            <dd class="col-8 col-sm-9">@Model.MemberSinceUtc.ToLocalTime().ToString("MMMM d, yyyy")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Last Login</dt>
            <dd class="col-8 col-sm-9">@(Model.LastLoginAtUtc.HasValue ? Model.LastLoginAtUtc.Value.ToLocalTime().ToString("MMMM d, yyyy h:mm tt") : "—")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Email Verified</dt>
            <dd class="col-8 col-sm-9">@(Model.EmailConfirmed ? "Yes" : "No")</dd>

            <dt class="col-4 col-sm-3 text-secondary">Phone Verified</dt>
            <dd class="col-8 col-sm-9">@(Model.PhoneNumberConfirmed ? "Yes" : "No")</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Security</h2>
        <partial name="_ChangePasswordForm" for="ChangePassword" />

        <hr />

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 py-2">
            <div>
                <h3 class="h6 fw-semibold small mb-1">Manage Sessions</h3>
                <p class="text-secondary small mb-0">View and sign out of your active sessions on other devices.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Not available yet</button>
        </div>
    </div>
</div>

<div class="text-center mb-4">
    <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i data-lucide="settings" class="me-1"></i>Notifications &amp; System Settings
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
