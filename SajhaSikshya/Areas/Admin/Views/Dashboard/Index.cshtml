@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">Admin Dashboard</h1>
        <p class="text-secondary mb-0">Platform overview at a glance.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon bg-primary-subtle text-primary"><i data-lucide="users"></i></div>
            <div>
                <p class="stat-card-label">Total Users</p>
                <p class="stat-card-value">&mdash;</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon bg-success-subtle text-success"><i data-lucide="book-open"></i></div>
            <div>
                <p class="stat-card-label">Courses</p>
                <p class="stat-card-value">&mdash;</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon bg-warning-subtle text-warning"><i data-lucide="graduation-cap"></i></div>
            <div>
                <p class="stat-card-label">Enrollments</p>
                <p class="stat-card-value">&mdash;</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-icon bg-info-subtle text-info"><i data-lucide="activity"></i></div>
            <div>
                <p class="stat-card-label">Active Today</p>
                <p class="stat-card-value">&mdash;</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body text-center py-5">
        <i data-lucide="construction" class="mb-3" style="width:40px;height:40px;color:var(--bs-secondary-color)"></i>
        <h2 class="h6 fw-semibold">Platform modules coming soon</h2>
        <p class="text-secondary mb-0">User and course management will appear here in a later phase.</p>
    </div>
</div>
