@using SajhaSikshya.Data.Enums
@using SajhaSikshya.Extensions
@using SajhaSikshya.ViewModels.Admin.Marketplace
@model AdminListingListViewModel
@{
    ViewData["Title"] = "Listing Moderation";
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Listing Moderation</h1>
    <p class="text-secondary mb-0">Review, approve, and manage every listing on the marketplace.</p>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2 mb-3">
            <input type="search" name="searchTerm" value="@Model.SearchTerm" class="form-control" style="max-width: 280px;"
                   placeholder="Search by title…" aria-label="Search" />
            <select name="status" class="form-select" style="max-width: 200px;" asp-items="EnumExtensions.GetSelectList<ListingStatus>(Model.Status)">
                <option value="">All Statuses</option>
            </select>
            <button type="submit" class="btn btn-outline-secondary">
                <i data-lucide="search" class="me-1"></i>Filter
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.Status.HasValue)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </form>

        @if (!Model.Page.Items.Any())
        {
            <p class="text-secondary text-center py-4 mb-0">No listings match this filter.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Seller</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var listing in Model.Page.Items)
                        {
                            <tr>
                                <td>@listing.Title</td>
                                <td>@listing.SellerName</td>
                                <td>@listing.CategoryName</td>
                                <td>@listing.FormattedPrice</td>
                                <td>@listing.StockQuantity</td>
                                <td><span class="badge @StatusBadgeClass(listing.Status)">@listing.StatusDisplay</span></td>
                                <td>@listing.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@listing.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                    @if (listing.Status == ListingStatus.PendingApproval)
                                    {
                                        <form asp-action="Approve" asp-route-id="@listing.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@listing.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-warning">Reject</button>
                                        </form>
                                    }
                                    @if (listing.Status == ListingStatus.Archived)
                                    {
                                        <form asp-action="Restore" asp-route-id="@listing.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                                        </form>
                                    }
                                    else if (listing.Status is not (ListingStatus.Sold or ListingStatus.Donated))
                                    {
                                        <form asp-action="Archive" asp-route-id="@listing.Id" method="post" class="d-inline js-delete-form"
                                              data-confirm="Archive '@listing.Title'? It will no longer be visible in the marketplace until restored.">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Archive</button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@listing.Id" method="post" class="d-inline js-delete-form"
                                          data-confirm="Delete '@listing.Title'? This cannot be undone from the UI.">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_QueryPreservingPagination" model="Model.Page" />
        }
    </div>
</div>

@functions {
    private static string StatusBadgeClass(ListingStatus status) => status switch
    {
        ListingStatus.Draft => "text-bg-secondary",
        ListingStatus.PendingApproval => "text-bg-info",
        ListingStatus.Active => "text-bg-success",
        ListingStatus.Reserved => "text-bg-warning",
        ListingStatus.Sold => "text-bg-dark",
        ListingStatus.Donated => "text-bg-primary",
        ListingStatus.Archived => "text-bg-secondary",
        ListingStatus.Rejected => "text-bg-danger",
        ListingStatus.OutOfStock => "text-bg-danger",
        _ => "text-bg-secondary",
    };
}
