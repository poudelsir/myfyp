@using SajhaSikshya.Extensions
@using SajhaSikshya.ViewModels.Admin.Reviews
@model AdminReviewQueueViewModel
@{
    ViewData["Title"] = "Review Moderation";
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Review Moderation</h1>
    <p class="text-secondary mb-0">Handle reported reviews, remove abusive content, and restore reviews removed in error.</p>
</div>

<div class="card">
    <div class="card-body">
        <ul class="nav nav-pills mb-3">
            <li class="nav-item">
                <a class="nav-link @(Model.ReportedOnly ? "active" : "")" asp-action="Index" asp-route-reportedOnly="true">Reported</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(!Model.ReportedOnly ? "active" : "")" asp-action="Index" asp-route-reportedOnly="false">All Reviews</a>
            </li>
        </ul>

        @if (!Model.Page.Items.Any())
        {
            <p class="text-secondary text-center py-4 mb-0">
                @(Model.ReportedOnly ? "No reported reviews right now." : "No reviews to show.")
            </p>
        }
        else
        {
            @foreach (var review in Model.Page.Items)
            {
                <div class="review-card @(review.IsDeleted ? "border-danger-subtle" : "")">
                    <div class="review-card-header">
                        <div>
                            <partial name="_StarRatingDisplay" model="(double)review.Rating" />
                            <div class="review-card-meta">
                                @review.ReviewerName → @review.RevieweeName · @review.ReviewTypeDisplay · "@review.ListingTitle" · Order @review.OrderReferenceNumber
                            </div>
                        </div>
                        <div class="text-end">
                            @if (review.ReportCount > 0)
                            {
                                <span class="badge text-bg-danger mb-1">@review.ReportCount report@(review.ReportCount == 1 ? "" : "s")</span>
                            }
                            @if (review.IsDeleted)
                            {
                                <span class="badge text-bg-secondary mb-1">Removed</span>
                            }
                            <div class="text-secondary small">@review.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(review.Title))
                    {
                        <p class="review-card-title mb-1">@review.Title</p>
                    }
                    @if (!string.IsNullOrEmpty(review.Comment))
                    {
                        <p class="mb-2">@review.Comment</p>
                    }
                    <div class="d-flex gap-2 flex-wrap">
                        @if (review.IsDeleted)
                        {
                            <form asp-action="Restore" asp-route-id="@review.Id" asp-route-reportedOnly="@Model.ReportedOnly" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Remove" asp-route-id="@review.Id" asp-route-reportedOnly="@Model.ReportedOnly" method="post"
                                  class="d-flex gap-2">
                                <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason (optional)" style="max-width: 220px;" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        }
                        @if (review.ReportCount > 0)
                        {
                            <form asp-action="ResetReportCount" asp-route-id="@review.Id" asp-route-reportedOnly="@Model.ReportedOnly" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Clear Reports</button>
                            </form>
                        }
                    </div>
                </div>
            }

            <partial name="_QueryPreservingPagination" model="Model.Page" />
        }
    </div>
</div>
