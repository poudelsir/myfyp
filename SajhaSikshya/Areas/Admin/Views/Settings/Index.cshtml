@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using SajhaSikshya.ViewModels.Admin.Settings
@model AdminSettingsViewModel
@{
    ViewData["Title"] = "Settings";
    var profilePostUrl = Url.Action("UpdatePersonalInfo", "Profile");
    var passwordPostUrl = Url.Action("ChangePassword", "Profile");
    var preferencesPostUrl = Url.Action("Preferences", "Notifications", new { area = "" });
}

<div class="mb-4">
    <span class="badge text-bg-primary mb-2">System Administrator Settings</span>
    <h1 class="h4 fw-bold mb-1">Settings</h1>
    <p class="text-secondary mb-0">Manage your administrator profile, security, and notification preferences.</p>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <div class="nav flex-column nav-pills settings-nav" id="settingsTabs" role="tablist" aria-orientation="vertical">
            <button class="nav-link active" id="settings-tab-profile" data-bs-toggle="pill" data-bs-target="#settings-profile" type="button" role="tab" aria-controls="settings-profile" aria-selected="true">
                <i data-lucide="user" class="me-2"></i>Admin Profile
            </button>
            <button class="nav-link" id="settings-tab-security" data-bs-toggle="pill" data-bs-target="#settings-security" type="button" role="tab" aria-controls="settings-security" aria-selected="false">
                <i data-lucide="lock" class="me-2"></i>Security
            </button>
            <button class="nav-link" id="settings-tab-notifications" data-bs-toggle="pill" data-bs-target="#settings-notifications" type="button" role="tab" aria-controls="settings-notifications" aria-selected="false">
                <i data-lucide="bell" class="me-2"></i>Notifications
            </button>
            <button class="nav-link" id="settings-tab-system" data-bs-toggle="pill" data-bs-target="#settings-system" type="button" role="tab" aria-controls="settings-system" aria-selected="false">
                <i data-lucide="settings-2" class="me-2"></i>System Preferences
            </button>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="tab-content" id="settingsTabContent">
            <div class="tab-pane fade show active" id="settings-profile" role="tabpanel" aria-labelledby="settings-tab-profile">
                <div class="card">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">Admin Profile</h2>
                        <partial name="_PersonalInfoForm" for="PersonalInfo" view-data='new ViewDataDictionary(ViewData) { ["PersonalInfoPostUrl"] = profilePostUrl, ["ReturnUrl"] = Url.Action("Index") + "#settings-profile", ["RoleLabel"] = "System Administrator" }' />
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="settings-security" role="tabpanel" aria-labelledby="settings-tab-security">
                <div class="card">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">Security</h2>
                        <partial name="_ChangePasswordForm" for="ChangePassword" view-data='new ViewDataDictionary(ViewData) { ["ChangePasswordPostUrl"] = passwordPostUrl, ["ReturnUrl"] = Url.Action("Index") + "#settings-security" }' />
                        <hr />
                        <dl class="row small mb-0">
                            <dt class="col-4 col-sm-3 text-secondary">Account Status</dt>
                            <dd class="col-8 col-sm-9">
                                <span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.IsActive ? "Active" : "Disabled")</span>
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="settings-notifications" role="tabpanel" aria-labelledby="settings-tab-notifications">
                <div class="card">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">Notification Preferences</h2>
                        <p class="text-secondary small mb-3">
                            Includes verification requests, order alerts, marketplace/listing activity, and system
                            announcements — the same categories every account can toggle, applied here to the
                            notifications an administrator receives.
                        </p>
                        <partial name="/Views/Notifications/_PreferencesForm.cshtml" model="Model.NotificationPreferences" view-data='new ViewDataDictionary(ViewData) { ["PreferencesPostUrl"] = preferencesPostUrl, ["ReturnUrl"] = Url.Action("Index") + "#settings-notifications" }' />
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="settings-system" role="tabpanel" aria-labelledby="settings-tab-system">
                <div class="card">
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-3">System Preferences</h2>
                        <p class="text-secondary small mb-3">
                            Platform-wide configuration lives in its own dedicated screens rather than as toggles
                            here, so changes go through the same audited flows as everything else in Admin.
                        </p>
                        <div class="list-group">
                            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                                <i data-lucide="folder-tree"></i>
                                <span class="flex-grow-1">
                                    <span class="d-block fw-semibold">Marketplace Categories</span>
                                    <span class="d-block text-secondary small">Departments and subcategories shown across the marketplace.</span>
                                </span>
                                <i data-lucide="chevron-right"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="Universities" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                                <i data-lucide="building-2"></i>
                                <span class="flex-grow-1">
                                    <span class="d-block fw-semibold">Universities</span>
                                    <span class="d-block text-secondary small">Institutions available for student verification and listings.</span>
                                </span>
                                <i data-lucide="chevron-right"></i>
                            </a>
                        </div>
                        <hr />
                        <dl class="row small mb-0">
                            <dt class="col-4 col-sm-3 text-secondary">Default Page Size</dt>
                            <dd class="col-8 col-sm-9">@SajhaSikshya.Constants.PaginationConstants.DefaultPageSize items per page</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            "use strict";
            var hash = window.location.hash;
            if (hash) {
                var trigger = document.getElementById("settings-tab-" + hash.replace("#settings-", ""));
                if (trigger && window.bootstrap) {
                    window.bootstrap.Tab.getOrCreateInstance(trigger).show();
                }
            }
        })();
    </script>
}
