@using SajhaSikshya.Data.Enums
@using SajhaSikshya.ViewModels.Admin.Verification
@model AdminVerificationDetailViewModel
@{
    var v = Model.Verification;
    ViewData["Title"] = $"Review: {v.StudentName}";
    var governmentIdImageUrl = Url.Action("Image", "VerificationImages", new { id = v.Id, type = "government", area = "" });
    var academicIdImageUrl = Url.Action("Image", "VerificationImages", new { id = v.Id, type = "academic", area = "" });
    var profilePhotoImageUrl = Url.Action("Image", "VerificationImages", new { id = v.Id, type = "profile", area = "" });
}

<div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <partial name="_VerificationStatusBadge" model="v.Status" />
        <h1 class="h4 fw-bold mb-0 mt-2">@v.StudentName</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i data-lucide="arrow-left" class="me-1"></i>Back to Queue
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h6 fw-semibold mb-1">Government Identity Document</h2>
        @if (!string.IsNullOrEmpty(v.GovernmentIdDocumentTypeDisplay))
        {
            <p class="text-secondary small mb-2">@v.GovernmentIdDocumentTypeDisplay</p>
        }
        <img src="@governmentIdImageUrl" alt="Government ID for @v.StudentName" class="img-fluid rounded border mb-4" />

        <h2 class="h6 fw-semibold mb-1">Academic Identity</h2>
        @if (v.HasAcademicId)
        {
            @if (!string.IsNullOrEmpty(v.AcademicIdDocumentTypeDisplay))
            {
                <p class="text-secondary small mb-2">@v.AcademicIdDocumentTypeDisplay</p>
            }
            <img src="@academicIdImageUrl" alt="Academic ID for @v.StudentName" class="img-fluid rounded border mb-4" />
        }
        else
        {
            <p class="text-secondary small mb-4">Not provided.</p>
        }

        <h2 class="h6 fw-semibold mb-2">Profile Photo</h2>
        <img src="@profilePhotoImageUrl" alt="Profile photo for @v.StudentName" class="img-fluid rounded border" style="max-width: 240px;" />
    </div>

    <div class="col-lg-6">
        <dl class="row small text-secondary mb-3">
            <dt class="col-4">Account Name</dt>
            <dd class="col-8">@v.StudentName</dd>
            <dt class="col-4">Email</dt>
            <dd class="col-8">@v.StudentEmail</dd>
            <dt class="col-4">Phone Number</dt>
            <dd class="col-8">@(string.IsNullOrWhiteSpace(v.StudentPhoneNumber) ? "—" : v.StudentPhoneNumber)</dd>
            <dt class="col-4">Seller Type</dt>
            <dd class="col-8">@(v.SellerTypeDisplay ?? "—")</dd>
            <dt class="col-4">Selling Categories</dt>
            <dd class="col-8">@(v.SellingCategoryDisplays.Any() ? string.Join(", ", v.SellingCategoryDisplays) : "—")</dd>
            <dt class="col-4">Submitted</dt>
            <dd class="col-8">@v.SubmittedAtUtc.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")</dd>
            @if (v.ReviewedAtUtc.HasValue)
            {
                <dt class="col-4">Reviewed</dt>
                <dd class="col-8">
                    @v.ReviewedAtUtc.Value.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")
                    @if (!string.IsNullOrEmpty(v.ReviewedByName))
                    {
                        <text> by @v.ReviewedByName</text>
                    }
                </dd>
            }
            @if (v.LastAction.HasValue)
            {
                <dt class="col-4">Action Taken</dt>
                <dd class="col-8">@v.LastActionDisplay</dd>
            }
        </dl>

        @if (!string.IsNullOrWhiteSpace(v.RejectionReason))
        {
            <div class="alert alert-danger">
                <strong>Reason given to student:</strong> @v.RejectionReason
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(v.AdminNotes))
        {
            <div class="alert alert-secondary">
                <strong>Internal notes:</strong> @v.AdminNotes
            </div>
        }

        @if (v.Status == VerificationStatus.Pending)
        {
            <div class="d-flex flex-wrap gap-2">
                <form asp-action="Approve" asp-route-id="@v.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success">
                        <i data-lucide="check" class="me-1"></i>Approve
                    </button>
                </form>
                <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#requestResubmissionModal">
                    <i data-lucide="rotate-ccw" class="me-1"></i>Request Resubmission
                </button>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i data-lucide="x" class="me-1"></i>Reject
                </button>
            </div>
        }
    </div>
</div>

@{
    var previousAttempts = Model.History.Items.Where(h => h.Id != v.Id).ToList();
}
@if (previousAttempts.Any())
{
    <hr class="my-4" />
    <h2 class="h6 fw-semibold mb-3">Previous Attempts</h2>
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th>Action</th>
                    <th>Reviewed</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var past in previousAttempts)
                {
                    <tr>
                        <td>@past.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                        <td><partial name="_VerificationStatusBadge" model="past.Status" /></td>
                        <td>@(past.LastActionDisplay ?? "—")</td>
                        <td>@(past.ReviewedAtUtc.HasValue ? past.ReviewedAtUtc.Value.ToLocalTime().ToString("MMM d, yyyy") : "—")</td>
                        <td>@(past.RejectionReason ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (v.Status == VerificationStatus.Pending)
{
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="Reject" asp-route-id="@v.Id" method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Reject Verification</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="rejectReason" class="form-label">Rejection reason (shown to the student)</label>
                            <textarea name="reason" id="rejectReason" class="form-control" rows="3" required maxlength="500"></textarea>
                        </div>
                        <div class="mb-0">
                            <label for="rejectNotes" class="form-label">Internal notes (admins only)</label>
                            <textarea name="adminNotes" id="rejectNotes" class="form-control" rows="2" maxlength="1000"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="requestResubmissionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="RequestResubmission" asp-route-id="@v.Id" method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Request Resubmission</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="resubmitReason" class="form-label">What needs to be fixed? (shown to the student)</label>
                            <textarea name="reason" id="resubmitReason" class="form-control" rows="3" required maxlength="500"
                                      placeholder="e.g. Photo is blurry — please upload a clearer image."></textarea>
                        </div>
                        <div class="mb-0">
                            <label for="resubmitNotes" class="form-label">Internal notes (admins only)</label>
                            <textarea name="adminNotes" id="resubmitNotes" class="form-control" rows="2" maxlength="1000"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">Request Resubmission</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}
